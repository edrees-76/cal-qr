<Application x:Class="CAL_QR.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:CAL_QR">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="Indigo" SecondaryColor="Amber" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- App-wide Font Family -->
            <FontFamily x:Key="CairoFont">/CAL-QR;component/Assets/Fonts/#Cairo</FontFamily>

            <!-- Custom Brushes -->
            <SolidColorBrush x:Key="PrimaryNavy" Color="#1A3A6B" />
            <SolidColorBrush x:Key="GoldAccent" Color="#C9A227" />
            <SolidColorBrush x:Key="SuccessGreen" Color="#2E7D32" />
            <SolidColorBrush x:Key="WarningYellow" Color="#F9A825" />
            <SolidColorBrush x:Key="ErrorRed" Color="#C62828" />

            <!-- Palette-tinted surface brushes (updated by ThemeService.Apply) -->
            <SolidColorBrush x:Key="AppBackground"        Color="#F2F4F8" />
            <SolidColorBrush x:Key="AppSurface"          Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppSurfaceAlt"       Color="#F7F8FA" />
            <SolidColorBrush x:Key="AppBorder"           Color="#E0E4EC" />
            <!-- DataGrid hover/selection tokens — Enjaz-style subtle approach -->
            <SolidColorBrush x:Key="DataGridHoverBrush"     Color="#EEF2FB" /><!-- كحليّ فاتح جداً عند التمرير -->
            <SolidColorBrush x:Key="DataGridSelectionBrush" Color="#D4E3F7" /><!-- أزرق ناعم عند التحديد -->

            <!-- Material Design overrides using our colors -->
            <SolidColorBrush x:Key="PrimaryHueLightBrush" Color="#2E5088" />
            <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="#1A3A6B" />
            <SolidColorBrush x:Key="PrimaryHueDarkBrush" Color="#0D2040" />
            <SolidColorBrush x:Key="SecondaryAccentBrush" Color="#C9A227" />

            <!-- Compatibility alias: MaterialDesignToolIconButton was removed in v5.0.0 -->
            <Style x:Key="MaterialDesignToolIconButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignToolButton}" />

            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="{StaticResource CairoFont}" />
            </Style>
            <Style TargetType="{x:Type Window}">
                <Setter Property="FontFamily" Value="{StaticResource CairoFont}" />
                <Setter Property="Icon" Value="/Assets/Logo/cal-qr-3d-icon.png" />
            </Style>
            <Style TargetType="{x:Type Control}">
                <Setter Property="FontFamily" Value="{StaticResource CairoFont}" />
            </Style>

            <!-- Color for inputs foreground -->
            <SolidColorBrush x:Key="PrimaryInputForeground" Color="#1A3A6B" />

            <!-- 1. TextBox Styles -->
            <Style x:Key="MaterialDesignOutlinedTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                <Setter Property="Height" Value="45" />
                <Setter Property="Padding" Value="12,8,12,8" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryInputForeground}" />
                <Setter Property="materialDesign:HintAssist.Foreground" Value="{DynamicResource PrimaryInputForeground}" />
                <Setter Property="CaretBrush" Value="{DynamicResource PrimaryInputForeground}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="MaterialDesignFilledTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource MaterialDesignFilledTextBox}">
                <Setter Property="Height" Value="45" />
                <Setter Property="Padding" Value="12,8,12,8" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryInputForeground}" />
                <Setter Property="materialDesign:HintAssist.Foreground" Value="{DynamicResource PrimaryInputForeground}" />
                <Setter Property="CaretBrush" Value="{DynamicResource PrimaryInputForeground}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <!-- 2. PasswordBox Styles -->
            <Style x:Key="MaterialDesignOutlinedPasswordBox" TargetType="{x:Type PasswordBox}" BasedOn="{StaticResource MaterialDesignOutlinedPasswordBox}">
                <Setter Property="Height" Value="45" />
                <Setter Property="Padding" Value="12,8,12,8" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryInputForeground}" />
                <Setter Property="materialDesign:HintAssist.Foreground" Value="{DynamicResource PrimaryInputForeground}" />
                <Setter Property="CaretBrush" Value="{DynamicResource PrimaryInputForeground}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="MaterialDesignFilledPasswordBox" TargetType="{x:Type PasswordBox}" BasedOn="{StaticResource MaterialDesignFilledPasswordBox}">
                <Setter Property="Height" Value="45" />
                <Setter Property="Padding" Value="12,8,12,8" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryInputForeground}" />
                <Setter Property="materialDesign:HintAssist.Foreground" Value="{DynamicResource PrimaryInputForeground}" />
                <Setter Property="CaretBrush" Value="{DynamicResource PrimaryInputForeground}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <!-- 3. ComboBox Styles -->
            <Style x:Key="MaterialDesignOutlinedComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
                <Setter Property="Height" Value="45" />
                <Setter Property="Padding" Value="12,8,12,8" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryInputForeground}" />
                <Setter Property="materialDesign:HintAssist.Foreground" Value="{DynamicResource PrimaryInputForeground}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="MaterialDesignFilledComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource MaterialDesignFilledComboBox}">
                <Setter Property="Height" Value="45" />
                <Setter Property="Padding" Value="12,8,12,8" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryInputForeground}" />
                <Setter Property="materialDesign:HintAssist.Foreground" Value="{DynamicResource PrimaryInputForeground}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <!-- 4. DatePicker Styles -->
            <Style x:Key="MaterialDesignOutlinedDatePicker" TargetType="{x:Type DatePicker}" BasedOn="{StaticResource MaterialDesignOutlinedDatePicker}">
                <Setter Property="Height" Value="45" />
                <Setter Property="Padding" Value="12,8,12,8" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryInputForeground}" />
                <Setter Property="materialDesign:HintAssist.Foreground" Value="{DynamicResource PrimaryInputForeground}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="MaterialDesignFilledDatePicker" TargetType="{x:Type DatePicker}" BasedOn="{StaticResource MaterialDesignFilledDatePicker}">
                <Setter Property="Height" Value="45" />
                <Setter Property="Padding" Value="12,8,12,8" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryInputForeground}" />
                <Setter Property="materialDesign:HintAssist.Foreground" Value="{DynamicResource PrimaryInputForeground}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <!-- 5. DatePickerTextBox Style -->
            <Style TargetType="{x:Type DatePickerTextBox}" BasedOn="{StaticResource {x:Type DatePickerTextBox}}">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryInputForeground}" />
                <Setter Property="CaretBrush" Value="{DynamicResource PrimaryInputForeground}" />
            </Style>

            <!-- 6. Global DataGrid style — Enjaz-style subtle hover/selection -->
            <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource MaterialDesignDataGrid}">
                <Setter Property="RowBackground"            Value="{DynamicResource MaterialDesignPaper}" />
                <Setter Property="AlternatingRowBackground" Value="{DynamicResource MaterialDesignBackground}" />
                <Setter Property="Background"               Value="{DynamicResource MaterialDesignPaper}" />
                <Setter Property="BorderBrush"              Value="{DynamicResource AppBorder}" />
                <Setter Property="Foreground"               Value="{DynamicResource MaterialDesignBody}" />
                <Setter Property="SelectionUnit"            Value="FullRow" />
                <Setter Property="RowStyle"                 Value="{DynamicResource UnifiedDataGridRowHoverStyle}" />
            </Style>

            <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                <Setter Property="Background" Value="{DynamicResource AppSurfaceAlt}" />
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
            </Style>

            <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="Foreground"  Value="{DynamicResource MaterialDesignBody}" />
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource DataGridSelectionBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryNavy}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 7. Unified DataGrid Row Hover Style — Enjaz approach: خلفية فاتحة + نصّ داكن -->
            <Style x:Key="UnifiedDataGridRowHoverStyle" TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                <Style.Triggers>
                    <!-- تمرير: كحليّ فاتح جداً — النصّ يبقى داكناً -->
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource DataGridHoverBrush}" />
                    </Trigger>
                    <!-- تحديد: أزرق ناعم — النصّ كحليّ داكن -->
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource DataGridSelectionBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryNavy}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 8. Unified Navy DataGrid Icon Style — الأيقونة دائماً كحليّ (الخلفية فاتحة دائماً) -->
            <Style x:Key="UnifiedNavyDataGridIconStyle" TargetType="materialDesign:PackIcon">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryNavy}" />
            </Style>

            <!-- 9. Unified Navy DataGrid TextBlock Style — الكحليّ دائماً (الخلفية فاتحة) -->
            <Style x:Key="UnifiedNavyDataGridTextBlockStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryNavy}" />
            </Style>

            <!-- 10. Unified Subtle DataGrid TextBlock Style — رمادي فاتح دائماً -->
            <Style x:Key="UnifiedSubtleDataGridTextBlockStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

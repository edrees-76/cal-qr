<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>CAL_QR</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\Logo\cal-qr-icon.ico</ApplicationIcon>
    <!-- مصدر رقم الإصدار للمثبِّت (deploy\build-installer.ps1 يقرؤه من هنا). يطابق «الإصدار: 1.0.0» في واجهة «عن البرنامج». -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.31" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.31" />
    <PackageReference Include="QRCoder" Version="1.4.3" />
    <PackageReference Include="MaterialDesignThemes" Version="5.0.0" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.0-rc2" />
    <PackageReference Include="ClosedXML" Version="0.102.3" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="QuestPDF" Version="2024.3.10" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Logo\nuclear-center-logo.png" />
    <Resource Include="Assets\Logo\nuclear-center-logo-removebg-preview.png" />
    <Resource Include="Assets\Logo\magic_eraser1782906686524.png" />
    <Resource Include="Assets\Fonts\Cairo.ttf" />
    <Resource Include="Assets\Logo\cal-qr-logo-flat.png" />
    <Resource Include="Assets\Logo\cal-qr-mark.png" />
    <Resource Include="Assets\Logo\cal-qr-icon.ico" />
    <Resource Include="Assets\Logo\logo_original_4k.png" />
    <Resource Include="Assets\Logo\efh-logo.jpg" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CAL-QR.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\Fonts\Cairo.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\Logo\nuclear-center-logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\Fonts\Cairo-Regular.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\Fonts\Cairo-ExtraBold.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\Logo\logo_original_enhanced_1024.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\Logo\establishment-logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Assets/Design مجلد مراجع بصرية: تصميم الشهادة والشعارات.
         net_8.cs مرجع بصريّ للمرحلة ٥، لا كود يُترجَم — وهو ملف C#
         كامل فيه Main، فتركه في الترجمة يُنتج نقطة دخول ثانية
         تتعارض مع WPF (CS0017). ولا يُترجَم من هذا المجلد شيء أبداً. -->
    <Compile Remove="Assets\Design\**\*.cs" />
  </ItemGroup>

</Project>

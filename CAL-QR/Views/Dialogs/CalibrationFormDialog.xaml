<Window x:Class="CAL_QR.Views.Dialogs.CalibrationFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="نموذج معايرة جهاز | Calibration Form" Height="620" Width="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="Transparent"
        FlowDirection="RightToLeft"
        WindowStyle="None"
        AllowsTransparency="True">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Border Background="White" BorderBrush="#1A3A6B">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="BorderThickness" Value="1.5" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WindowState}" Value="Maximized">
                        <Setter Property="CornerRadius" Value="0" />
                        <Setter Property="BorderThickness" Value="0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,15" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding FormTitle}" FontSize="18" FontWeight="Bold" Foreground="#1A3A6B" FontFamily="{StaticResource CairoFont}" />
                    <TextBlock Text="{Binding FormSubtitle}" FontSize="11" Foreground="#707070" FontFamily="{StaticResource CairoFont}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnMaximize" Style="{StaticResource MaterialDesignFlatButton}" Width="30" Height="30" Padding="0" Click="MaximizeButton_Click" ToolTip="تكبير/استعادة" Margin="0,0,5,0">
                        <materialDesign:PackIcon x:Name="IconMaximize" Foreground="#1A3A6B" Width="20" Height="20">
                            <materialDesign:PackIcon.Style>
                                <Style TargetType="materialDesign:PackIcon">
                                    <Setter Property="Kind" Value="WindowMaximize" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WindowState}" Value="Maximized">
                                            <Setter Property="Kind" Value="WindowRestore" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignFlatButton}" Width="30" Height="30" Padding="0" Click="CloseButton_Click" ToolTip="إغلاق">
                        <materialDesign:PackIcon Kind="Close" Foreground="#C62828" Width="20" Height="20" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Form Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 1. Device Info Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="أولاً: بيانات الجهاز" FontSize="13" FontWeight="Bold" Foreground="#C9A227" FontFamily="{StaticResource CairoFont}" />
                        <Separator Margin="0,5,0,0" />
                    </StackPanel>

                    <!-- Device Info Fields -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Margin="5">
                            <TextBlock Text="الجهة المالكة *" FontSize="11" FontWeight="Bold" Foreground="#1A3A6B" Margin="0,0,0,5" FontFamily="{StaticResource CairoFont}" />
                            <ComboBox IsEditable="True" ItemsSource="{Binding Owners}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedOwner}" Text="{Binding OwnerText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedComboBox}" Height="40" FontFamily="{StaticResource CairoFont}" ToolTip="{Binding OwnerText}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="5">
                            <TextBlock Text="نوع الجهاز *" FontSize="11" FontWeight="Bold" Foreground="#1A3A6B" Margin="0,0,0,5" FontFamily="{StaticResource CairoFont}" />
                            <ComboBox IsEditable="True" ItemsSource="{Binding DeviceTypes}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedDeviceType}" Text="{Binding DeviceTypeText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedComboBox}" Height="40" FontFamily="{StaticResource CairoFont}" ToolTip="{Binding DeviceTypeText}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="5">
                            <TextBlock Text="الموديل *" FontSize="11" FontWeight="Bold" Foreground="#1A3A6B" Margin="0,0,0,5" FontFamily="{StaticResource CairoFont}" />
                            <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="40" FontFamily="{StaticResource CairoFont}" />
                        </StackPanel>

                        <StackPanel Grid.Column="3" Margin="5">
                            <TextBlock Text="الرقم التسلسلي *" FontSize="11" FontWeight="Bold" Foreground="#1A3A6B" Margin="0,0,0,5" FontFamily="{StaticResource CairoFont}" />
                            <TextBox Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="40" FontFamily="{StaticResource CairoFont}" />
                        </StackPanel>
                    </Grid>

                    <!-- Duplicate Warning -->
                    <Border Grid.Row="2" Background="#FFEBEE" BorderBrush="#EF9A9A" BorderThickness="1" CornerRadius="4" Padding="10" Margin="5,0,5,15" Visibility="{Binding HasSerialNumberWarning, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                        <TextBlock Text="{Binding SerialNumberWarning}" Foreground="#C62828" FontSize="11" TextWrapping="Wrap" FontFamily="{StaticResource CairoFont}" />
                    </Border>

                    <!-- 2. Calibration Info Header -->
                    <StackPanel Grid.Row="3" Margin="0,0,0,10">
                        <TextBlock Text="ثانياً: بيانات المعايرة والشهادة" FontSize="13" FontWeight="Bold" Foreground="#C9A227" FontFamily="{StaticResource CairoFont}" />
                        <Separator Margin="0,5,0,0" />
                    </StackPanel>

                    <!-- Calibration Fields -->
                    <Grid Grid.Row="4" Margin="0,0,0,15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Row 1 -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="5">
                            <TextBlock Text="{Binding CertificateNumberLabel}" FontSize="11" FontWeight="Bold" Foreground="#1A3A6B" Margin="0,0,0,5" FontFamily="{StaticResource CairoFont}" />
                            <TextBox Text="{Binding CertificateNumber, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsCertificateNumberReadOnly}" materialDesign:HintAssist.Hint="{Binding CertificateNumberHint}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="40" FontFamily="{StaticResource CairoFont}" ToolTip="رقم الشهادة يُولّده النظام عند إصدارها. يبقى قابلاً للتحرير في السجلات المُرحَّلة ذات الترقيم الورقي السابق." />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="5">
                            <TextBlock Text="تاريخ المعايرة *" FontSize="11" FontWeight="Bold" Foreground="#1A3A6B" Margin="0,0,0,5" FontFamily="{StaticResource CairoFont}" />
                            <DatePicker SelectedDate="{Binding CalibrationDate}" Style="{StaticResource MaterialDesignOutlinedDatePicker}" Height="40" FontFamily="{StaticResource CairoFont}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="5">
                            <TextBlock Text="تاريخ الانتهاء *" FontSize="11" FontWeight="Bold" Foreground="#1A3A6B" Margin="0,0,0,5" FontFamily="{StaticResource CairoFont}" />
                            <DatePicker SelectedDate="{Binding ExpiryDate}" Style="{StaticResource MaterialDesignOutlinedDatePicker}" Height="40" FontFamily="{StaticResource CairoFont}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="3" Margin="5">
                            <TextBlock Text="نتيجة المعايرة *" FontSize="11" FontWeight="Bold" Foreground="#1A3A6B" Margin="0,0,0,5" FontFamily="{StaticResource CairoFont}" />
                            <ComboBox SelectedValue="{Binding SelectedResult}" SelectedValuePath="Tag" Style="{StaticResource MaterialDesignOutlinedComboBox}" Height="40" FontFamily="{StaticResource CairoFont}">
                                <ComboBoxItem Content="✅ ناجح" Tag="Passed" />
                                <ComboBoxItem Content="❌ راسب" Tag="Failed" />
                                <ComboBoxItem Content="⚠️ مشروط" Tag="Conditional" />
                            </ComboBox>
                        </StackPanel>

                        <!-- Row 2 -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="5">
                            <TextBlock Text="المهندس المعايِر *" FontSize="11" FontWeight="Bold" Foreground="#1A3A6B" Margin="0,0,0,5" FontFamily="{StaticResource CairoFont}" />
                            <ComboBox IsEditable="True" ItemsSource="{Binding Engineers}" Text="{Binding EngineerName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedComboBox}" Height="40" FontFamily="{StaticResource CairoFont}" />
                        </StackPanel>
                    </Grid>

                    <!-- Description & Attachments -->
                    <Grid Grid.Row="5" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Description -->
                        <StackPanel Grid.Column="0" Margin="5">
                            <TextBlock Text="وصف المعايرة / ملاحظات" FontSize="11" FontWeight="Bold" Foreground="#1A3A6B" Margin="0,0,0,5" FontFamily="{StaticResource CairoFont}" />
                            <TextBox Text="{Binding Description}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="120" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" FontFamily="{StaticResource CairoFont}" />
                        </StackPanel>

                        <!-- Attachments -->
                        <StackPanel Grid.Column="1" Margin="5">
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="المرفقات والشهادات الممسوحة" FontSize="11" FontWeight="Bold" Foreground="#1A3A6B" VerticalAlignment="Center" FontFamily="{StaticResource CairoFont}" />
                                <Button Grid.Column="1" Command="{Binding AddAttachmentCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Padding="8,0" FontFamily="{StaticResource CairoFont}">
                                    <Button.ContentTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Attachment" Margin="0,0,3,0" VerticalAlignment="Center" />
                                                <TextBlock Text="إضافة" VerticalAlignment="Center" FontSize="11" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </Button.ContentTemplate>
                                </Button>
                            </Grid>

                            <!-- Attachment List Box -->
                            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Height="120" Background="#FAFAFA">
                                <ListBox ItemsSource="{Binding Attachments}" BorderThickness="0" Background="Transparent" Padding="5" MouseDoubleClick="AttachmentItem_MouseDoubleClick">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="ToolTip" Value="انقر نقراً مزدوجاً لفتح الملف" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="290">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Kind="FileDocument" Foreground="#1A3A6B" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontFamily="{StaticResource CairoFont}" />
                                                <Button Grid.Column="2" Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignToolIconButton}" Width="25" Height="25" Padding="0">
                                                    <materialDesign:PackIcon Kind="Delete" Foreground="#C62828" Width="14" Height="14" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <!-- Footer Actions -->
            <Grid Grid.Row="2" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <!-- Errors message -->
                <TextBlock Grid.Column="0" Text="{Binding ValidationErrors}" Foreground="#C62828" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" FontFamily="{StaticResource CairoFont}" Visibility="{Binding HasValidationErrors, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- متاح في وضع التعديل فقط: الشهادة تحتاج سجلاً محفوظاً تُنسب إليه -->
                    <Button Command="{Binding IssueCertificateCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                            Height="40" Margin="0,0,10,0" Foreground="#1A3A6B" BorderBrush="#1A3A6B"
                            FontFamily="{StaticResource CairoFont}"
                            ToolTip="إنشاء شهادة معايرة رسمية من هذا السجل"
                            Visibility="{Binding CanIssueCertificate, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileDocument" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="إنشاء شهادة" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <!-- مسار النوع السادس: تقرير حالة معايرة، لسجلّ تعذّرت معايرته -->
                    <Button Command="{Binding IssueStatusReportCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                            Height="40" Margin="0,0,10,0" Foreground="#B71C1C" BorderBrush="#B71C1C"
                            FontFamily="{StaticResource CairoFont}"
                            ToolTip="إصدار تقرير حالة لسجل تعذّرت معايرته (بدل شهادة معايرة)"
                            Visibility="{Binding CanIssueCertificate, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileAlert" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="إصدار تقرير حالة" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <!-- مكمّل لزر الإنشاء أعلاه: يظهر بدلاً منه حين توجد شهادة صادرة -->
                    <Button Command="{Binding EditCertificateCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#1A3A6B" BorderBrush="#1A3A6B"
                            Height="40" Margin="0,0,10,0"
                            FontFamily="{StaticResource CairoFont}"
                            ToolTip="تعديل الشهادة الصادرة لهذا السجل"
                            Visibility="{Binding HasCertificate, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileDocumentEdit" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="تعديل الشهادة" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SaveCommand}" Content="حفظ" Style="{StaticResource MaterialDesignRaisedButton}" Background="#1A3A6B" BorderBrush="#1A3A6B" Height="40" Margin="0,0,10,0" FontFamily="{StaticResource CairoFont}" />
                    <Button Content="إلغاء" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#707070" BorderBrush="#E0E0E0" Height="40" Width="80" Click="CancelButton_Click" FontFamily="{StaticResource CairoFont}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

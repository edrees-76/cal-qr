<Window x:Class="CAL_QR.Views.Dialogs.CertificateFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:CAL_QR.Helpers"
        Title="إنشاء شهادة معايرة | Certificate Form" Height="760" Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="Transparent"
        FlowDirection="RightToLeft"
        WindowStyle="None"
        AllowsTransparency="True">

    <!--
        تخطيط وظيفي لا نهائي. التصميم البصري مؤجَّل إلى المرحلة ٤ عمداً:
        الغرض هنا إتاحة كل حقل من الأقسام الستة للتحرير والاختبار، لا إخراج الوثيقة.
    -->

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#C9A227" />
            <Setter Property="FontFamily" Value="{StaticResource CairoFont}" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#1A3A6B" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FontFamily" Value="{StaticResource CairoFont}" />
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="Height" Value="38" />
            <Setter Property="FontFamily" Value="{StaticResource CairoFont}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="FieldDate" TargetType="DatePicker" BasedOn="{StaticResource MaterialDesignOutlinedDatePicker}">
            <Setter Property="Height" Value="38" />
            <Setter Property="FontFamily" Value="{StaticResource CairoFont}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- Row header style (# column) -->
        <Style x:Key="GridRowHeader" TargetType="DataGridRowHeader">
            <Setter Property="Background" Value="#ECEFF1" />
            <Setter Property="Foreground" Value="#546E7A" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Width" Value="36" />
            <Setter Property="BorderBrush" Value="#CFD8DC" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="FontFamily" Value="{StaticResource CairoFont}" />
        </Style>

        <Style x:Key="CenteredCellElement" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="GridStyle" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="All" />
            <Setter Property="MinHeight" Value="90" />
            <Setter Property="MaxHeight" Value="220" />
            <Setter Property="FontFamily" Value="{StaticResource CairoFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E0E0E0" />
            <Setter Property="BorderBrush" Value="#CFD8DC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="AlternationCount" Value="2" />
            <Setter Property="AlternatingRowBackground" Value="#F0F4F8" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="RowHeaderWidth" Value="36" />
            <Setter Property="RowHeight" Value="36" />
            <Setter Property="ColumnHeaderHeight" Value="38" />
            <Setter Property="RowHeaderStyle" Value="{StaticResource GridRowHeader}" />
        </Style>

        <Style x:Key="RowActionButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontFamily" Value="{StaticResource CairoFont}" />
        </Style>
    </Window.Resources>

    <Border Background="White" BorderBrush="#1A3A6B">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="BorderThickness" Value="1.5" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WindowState}" Value="Maximized">
                        <Setter Property="CornerRadius" Value="0" />
                        <Setter Property="BorderThickness" Value="0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- شريط العنوان -->
            <Grid Grid.Row="0" Margin="0,0,0,12" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding FormTitle}" FontSize="18" FontWeight="Bold" Foreground="#1A3A6B" FontFamily="{StaticResource CairoFont}" />
                    <TextBlock Text="{Binding CertificateTemplateType, StringFormat=نموذج: {0}}" FontSize="11" Foreground="#707070" FontFamily="{StaticResource CairoFont}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnMaximize" Style="{StaticResource MaterialDesignFlatButton}" Width="30" Height="30" Padding="0" Click="MaximizeButton_Click" ToolTip="تكبير/استعادة" Margin="0,0,5,0">
                        <materialDesign:PackIcon x:Name="IconMaximize" Foreground="#1A3A6B" Width="20" Height="20">
                            <materialDesign:PackIcon.Style>
                                <Style TargetType="materialDesign:PackIcon">
                                    <Setter Property="Kind" Value="WindowMaximize" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WindowState}" Value="Maximized">
                                            <Setter Property="Kind" Value="WindowRestore" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignFlatButton}" Width="30" Height="30" Padding="0" Click="CloseButton_Click" ToolTip="إغلاق">
                        <materialDesign:PackIcon Kind="Close" Foreground="#C62828" Width="20" Height="20" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- المحتوى -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="5">

                    <!-- شريط تحذير النوع بلا قالب: ظاهر غير حاجب، لا يمنع الحفظ -->
                    <Border Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1" CornerRadius="4"
                            Padding="10" Margin="0,0,0,12"
                            Visibility="{Binding HasNoTemplateWarning, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AlertCircleOutline" Foreground="#F57F17" Width="20" Height="20" VerticalAlignment="Top" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding NoTemplateWarningText}" Foreground="#795548" FontSize="11.5"
                                       TextWrapping="Wrap" MaxWidth="760" FontFamily="{StaticResource CairoFont}" />
                        </StackPanel>
                    </Border>

                    <!-- ═══ ١. بيانات الجهة والجهاز ═══ -->
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="1. Client &amp; Instrument Identification" FontSize="13" FontWeight="Bold" Foreground="#C9A227" FontFamily="{StaticResource CairoFont}" />
                        <TextBlock Text="بيانات الجهة والجهاز" FontSize="11" Foreground="#9E9E9E" FontFamily="{StaticResource CairoFont}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Separator Margin="0,4,0,8" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="4">
                            <TextBlock Text="Owner Organization" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ClientName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" helpers:WatermarkHelper.Watermark="الجهة المالكة للجهاز" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="4">
                            <TextBlock Text="Client Address" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ClientAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" helpers:WatermarkHelper.Watermark="عنوان الجهة" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="4">
                            <TextBlock Text="Reference No." Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ReferenceNo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" helpers:WatermarkHelper.Watermark="رقم المرجع" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="3" Margin="4">
                            <TextBlock Text="Detector Type" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding DetectorType, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" helpers:WatermarkHelper.Watermark="نوع الكاشف" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="4">
                            <TextBlock Text="Device Model" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding DeviceModel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" helpers:WatermarkHelper.Watermark="موديل الجهاز" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="4">
                            <TextBlock Text="Serial Number" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding DeviceSerialNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" helpers:WatermarkHelper.Watermark="الرقم التسلسلي" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="4">
                            <TextBlock Text="Manufacturer" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding DeviceManufacturer, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" helpers:WatermarkHelper.Watermark="الشركة المصنّعة" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="3" Margin="4">
                            <TextBlock Text="Survey Meter Model" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding SurveyMeterModel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" helpers:WatermarkHelper.Watermark="موديل جهاز المسح المرجعي" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="4">
                            <TextBlock Text="Survey Meter S/N" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding SurveyMeterSerialNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" helpers:WatermarkHelper.Watermark="تسلسلي جهاز المسح المرجعي" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="4">
                            <TextBlock Text="Calibration Date" Style="{StaticResource FieldLabel}" />
                            <DatePicker SelectedDate="{Binding CalibrationDate}" Style="{StaticResource FieldDate}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="4">
                            <TextBlock Text="Issue Date" Style="{StaticResource FieldLabel}" />
                            <DatePicker SelectedDate="{Binding IssueDate}" Style="{StaticResource FieldDate}" />
                        </StackPanel>
                    </Grid>

                    <!-- ═══ ٢. الظروف البيئية ═══ -->
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="2. Environmental Conditions" FontSize="13" FontWeight="Bold" Foreground="#C9A227" FontFamily="{StaticResource CairoFont}" />
                        <TextBlock Text="الظروف البيئية" FontSize="11" Foreground="#9E9E9E" FontFamily="{StaticResource CairoFont}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Separator Margin="0,4,0,8" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="4">
                            <TextBlock Text="Temperature" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Temperature, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" helpers:WatermarkHelper.Watermark="°C مثال: 23.0 ± 2.0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="4">
                            <TextBlock Text="Relative Humidity" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding RelativeHumidity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" helpers:WatermarkHelper.Watermark="% RH مثال: 50 ± 10" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="4">
                            <TextBlock Text="Atmospheric Pressure" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding AtmosphericPressure, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" helpers:WatermarkHelper.Watermark="kPa مثال: 101.30 ± 1.00" />
                        </StackPanel>
                    </Grid>

                    <!-- ═══ ٣. نتائج المعايرة ═══ -->
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="3. Calibration Results" FontSize="13" FontWeight="Bold" Foreground="#C9A227" FontFamily="{StaticResource CairoFont}" />
                        <TextBlock Text="نتائج المعايرة" FontSize="11" Foreground="#9E9E9E" FontFamily="{StaticResource CairoFont}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Separator Margin="0,4,0,8" />

                    <StackPanel Orientation="Horizontal" Margin="4,0,4,6">
                        <Button Command="{Binding AddCalibrationResultCommand}" Content="إضافة صفّ نتيجة" Style="{StaticResource RowActionButton}" />
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding CalibrationResults}" Style="{StaticResource GridStyle}" Margin="4,0,4,10" LoadingRow="DataGrid_LoadingRow">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridColumnHeader">
                                            <Border x:Name="HeaderBorder"
                                                    Background="White"
                                                    BorderBrush="#1A3A6B"
                                                    BorderThickness="0,1,1,1"
                                                    Padding="8,6">
                                                <ContentPresenter
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    TextElement.Foreground="#1A3A6B" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="Content" Value="{x:Null}">
                                                    <Setter TargetName="HeaderBorder" Property="Background" Value="White" />
                                                    <Setter TargetName="HeaderBorder" Property="BorderThickness" Value="0" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="FontSize" Value="11" />
                                <Setter Property="FontFamily" Value="{StaticResource CairoFont}" />
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Source ID" Binding="{Binding SourceId}" Width="1*" ElementStyle="{StaticResource CenteredCellElement}" />
                            <DataGridTextColumn Header="Radionuclide" Binding="{Binding Radionuclide}" Width="1*" ElementStyle="{StaticResource CenteredCellElement}" />
                            <DataGridTextColumn Header="Scale" Binding="{Binding Scale}" Width="0.8*" ElementStyle="{StaticResource CenteredCellElement}" />
                            <DataGridTextColumn Header="Ref. Dose Level" Binding="{Binding ReferenceDoseLevel}" Width="1*" ElementStyle="{StaticResource CenteredCellElement}" />
                            <DataGridTextColumn Header="Ref. Value" Binding="{Binding ReferenceValue}" Width="1*" ElementStyle="{StaticResource CenteredCellElement}" />
                            <DataGridTextColumn Header="Measured Reading" Binding="{Binding MeasuredReading}" Width="1*" ElementStyle="{StaticResource CenteredCellElement}" />
                            <DataGridTextColumn Header="CF" Binding="{Binding CorrectionFactor}" Width="0.9*" ElementStyle="{StaticResource CenteredCellElement}" />
                            <DataGridTextColumn Header="AE %" Binding="{Binding RelativeError}" Width="0.9*" ElementStyle="{StaticResource CenteredCellElement}" />
                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="0.7*" ElementStyle="{StaticResource CenteredCellElement}" />
                            <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="1*" ElementStyle="{StaticResource CenteredCellElement}" />
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.RemoveCalibrationResultCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignToolIconButton}" Width="26" Height="26" Padding="0" ToolTip="حذف الصفّ">
                                            <materialDesign:PackIcon Kind="Delete" Foreground="#C62828" Width="14" Height="14" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Nuclide Summary" Style="{StaticResource FieldLabel}" Margin="4,4,4,4" />
                    <StackPanel Orientation="Horizontal" Margin="4,0,4,6">
                        <Button Command="{Binding AddNuclideSummaryCommand}" Content="إضافة صفّ نويدة" Style="{StaticResource RowActionButton}" />
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding NuclideSummaries}" Style="{StaticResource GridStyle}" MinHeight="70" Margin="4,0,4,10" LoadingRow="DataGrid_LoadingRow">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridColumnHeader">
                                            <Border x:Name="HeaderBorder"
                                                    Background="White"
                                                    BorderBrush="#1A3A6B"
                                                    BorderThickness="0,1,1,1"
                                                    Padding="8,6">
                                                <ContentPresenter
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    TextElement.Foreground="#1A3A6B" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="Content" Value="{x:Null}">
                                                    <Setter TargetName="HeaderBorder" Property="Background" Value="White" />
                                                    <Setter TargetName="HeaderBorder" Property="BorderThickness" Value="0" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="FontSize" Value="11" />
                                <Setter Property="FontFamily" Value="{StaticResource CairoFont}" />
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Radionuclide" Binding="{Binding Radionuclide}" Width="1*" ElementStyle="{StaticResource CenteredCellElement}" />
                            <DataGridTextColumn Header="Average CF (CFavg)" Binding="{Binding AverageCorrectionFactor}" Width="1.5*" ElementStyle="{StaticResource CenteredCellElement}" />
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.RemoveNuclideSummaryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignToolIconButton}" Width="26" Height="26" Padding="0" ToolTip="حذف الصفّ">
                                            <materialDesign:PackIcon Kind="Delete" Foreground="#C62828" Width="14" Height="14" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="4">
                            <TextBlock Text="Corrected Reading Formula" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding CorrectedReadingFormula, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" helpers:WatermarkHelper.Watermark="معادلة القراءة المصحّحة" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="4">
                            <TextBlock Text="Compliance Verdict" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ComplianceVerdict, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" helpers:WatermarkHelper.Watermark="حكم الامتثال النهائي" />
                        </StackPanel>
                    </Grid>

                    <!-- ═══ ٤. المنهجية والمعلومات التقنية ═══ -->
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="4. Methodology &amp; Technical Information" FontSize="13" FontWeight="Bold" Foreground="#C9A227" FontFamily="{StaticResource CairoFont}" />
                        <TextBlock Text="المنهجية والمعلومات التقنية" FontSize="11" Foreground="#9E9E9E" FontFamily="{StaticResource CairoFont}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Separator Margin="0,4,0,8" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="4">
                            <TextBlock Text="Procedure No." Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ProcedureNo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" helpers:WatermarkHelper.Watermark="رقم الإجراء" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="4">
                            <TextBlock Text="Calibration Location" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding CalibrationLocation, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" helpers:WatermarkHelper.Watermark="موقع إجراء المعايرة" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="4">
                            <TextBlock Text="Calibration Mode" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding CalibrationMode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" helpers:WatermarkHelper.Watermark="نمط المعايرة" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="4">
                            <TextBlock Text="Measurement Type" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding MeasurementType, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" helpers:WatermarkHelper.Watermark="نوع القياس" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="4">
                            <TextBlock Text="Distance" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Distance, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" helpers:WatermarkHelper.Watermark="المسافة بين المصدر والكاشف" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="4">
                            <TextBlock Text="Instrumentation" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Instrumentation, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" helpers:WatermarkHelper.Watermark="الأجهزة المستعملة في المعايرة" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="4">
                            <TextBlock Text="Counting Time" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding CountingTime, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" helpers:WatermarkHelper.Watermark="زمن العدّ" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="4">
                            <TextBlock Text="Counting Unit" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding CountingUnit, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" helpers:WatermarkHelper.Watermark="وحدة العدّ" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="4">
                            <TextBlock Text="Calibration Standard" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding CalibrationStandard, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="60"
                                     TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                                     FontFamily="{StaticResource CairoFont}"
                                     helpers:WatermarkHelper.Watermark="المرجع الإجرائي للمعايرة" />
                        </StackPanel>
                    </Grid>

                    <!-- ═══ المنهجية — قسم مشروط بـ MethodologyEnabled ═══ -->
                    <StackPanel Visibility="{Binding MethodologyEnabled, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="4">
                                <TextBlock Text="Radiation Source" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding RadiationSource, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" helpers:WatermarkHelper.Watermark="المصدر الإشعاعي المستخدم" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="4">
                                <TextBlock Text="Reference Geometry" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding ReferenceGeometry, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" helpers:WatermarkHelper.Watermark="الهندسة المرجعية" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="4">
                                <TextBlock Text="Methodology" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding MethodologyText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="70"
                                         TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                                         FontFamily="{StaticResource CairoFont}"
                                         helpers:WatermarkHelper.Watermark="وصف منهجية المعايرة" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="4">
                                <TextBlock Text="Traceability Reference" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding TraceabilityReference, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="70"
                                         TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                                         FontFamily="{StaticResource CairoFont}"
                                         helpers:WatermarkHelper.Watermark="مرجع القابلية للتتبّع" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- ═══ ٥. ميزانية عدم اليقين — قسم مشروط بـ UncertaintyEnabled ═══ -->
                    <StackPanel Visibility="{Binding UncertaintyEnabled, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="5. Uncertainty Budget" FontSize="13" FontWeight="Bold" Foreground="#C9A227" FontFamily="{StaticResource CairoFont}" />
                            <TextBlock Text="ميزانية عدم اليقين" FontSize="11" Foreground="#9E9E9E" FontFamily="{StaticResource CairoFont}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Separator Margin="0,4,0,8" />

                        <StackPanel Orientation="Horizontal" Margin="4,0,4,6">
                            <Button Command="{Binding AddUncertaintyComponentCommand}" Content="إضافة مكوّن" Style="{StaticResource RowActionButton}" />
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding UncertaintyComponents}" Style="{StaticResource GridStyle}" Margin="4,0,4,10" LoadingRow="DataGrid_LoadingRow">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridColumnHeader">
                                                <Border x:Name="HeaderBorder"
                                                        Background="White"
                                                        BorderBrush="#1A3A6B"
                                                        BorderThickness="0,1,1,1"
                                                        Padding="8,6">
                                                    <ContentPresenter
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        TextElement.Foreground="#1A3A6B" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="Content" Value="{x:Null}">
                                                        <Setter TargetName="HeaderBorder" Property="Background" Value="White" />
                                                        <Setter TargetName="HeaderBorder" Property="BorderThickness" Value="0" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="FontSize" Value="11" />
                                    <Setter Property="FontFamily" Value="{StaticResource CairoFont}" />
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Component" Binding="{Binding ComponentName}" Width="2*" ElementStyle="{StaticResource CenteredCellElement}" />
                                <DataGridTextColumn Header="Evaluation Type" Binding="{Binding EvaluationType}" Width="0.8*" ElementStyle="{StaticResource CenteredCellElement}" />
                                <DataGridTextColumn Header="Std. Uncertainty" Binding="{Binding StandardUncertainty}" Width="1.2*" ElementStyle="{StaticResource CenteredCellElement}" />
                                <DataGridTextColumn Header="Contribution %" Binding="{Binding ContributionPercent}" Width="1*" ElementStyle="{StaticResource CenteredCellElement}" />
                                <DataGridTextColumn Header="Distribution" Binding="{Binding Distribution}" Width="1*" ElementStyle="{StaticResource CenteredCellElement}" />
                                <DataGridTemplateColumn Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.RemoveUncertaintyComponentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignToolIconButton}" Width="26" Height="26" Padding="0" ToolTip="حذف الصفّ">
                                                <materialDesign:PackIcon Kind="Delete" Foreground="#C62828" Width="14" Height="14" />
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="4">
                                <TextBlock Text="Combined Uncertainty" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding CombinedUncertainty, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" helpers:WatermarkHelper.Watermark="عدم اليقين المركّب" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4">
                                <TextBlock Text="Expanded Uncertainty" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding ExpandedUncertainty, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" helpers:WatermarkHelper.Watermark="عدم اليقين الموسّع" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="4">
                                <TextBlock Text="Coverage Factor (k)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding CoverageFactor, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" helpers:WatermarkHelper.Watermark="معامل التغطية" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- ═══ ٦. الفحوص الوظيفية ═══ -->
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="6. Functional Checks &amp; Notes" FontSize="13" FontWeight="Bold" Foreground="#C9A227" FontFamily="{StaticResource CairoFont}" />
                        <TextBlock Text="الفحوص الوظيفية والملاحظات" FontSize="11" Foreground="#9E9E9E" FontFamily="{StaticResource CairoFont}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Separator Margin="0,4,0,8" />

                    <StackPanel Orientation="Horizontal" Margin="4,0,4,6">
                        <Button Command="{Binding AddFunctionalCheckCommand}" Content="إضافة فحص" Style="{StaticResource RowActionButton}" />
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding FunctionalChecks}" Style="{StaticResource GridStyle}" Margin="4,0,4,10" LoadingRow="DataGrid_LoadingRow">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridColumnHeader">
                                            <Border x:Name="HeaderBorder"
                                                    Background="White"
                                                    BorderBrush="#1A3A6B"
                                                    BorderThickness="0,1,1,1"
                                                    Padding="8,6">
                                                <ContentPresenter
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    TextElement.Foreground="#1A3A6B" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="Content" Value="{x:Null}">
                                                    <Setter TargetName="HeaderBorder" Property="Background" Value="White" />
                                                    <Setter TargetName="HeaderBorder" Property="BorderThickness" Value="0" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="FontSize" Value="11" />
                                <Setter Property="FontFamily" Value="{StaticResource CairoFont}" />
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Check Name" Binding="{Binding CheckName}" Width="2*" ElementStyle="{StaticResource CenteredCellElement}" />
                            <DataGridTextColumn Header="Requirement" Binding="{Binding Requirement}" Width="1.5*" ElementStyle="{StaticResource CenteredCellElement}" />
                            <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="1*" ElementStyle="{StaticResource CenteredCellElement}" />
                            <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="1.2*" ElementStyle="{StaticResource CenteredCellElement}" />
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.RemoveFunctionalCheckCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignToolIconButton}" Width="26" Height="26" Padding="0" ToolTip="حذف الصفّ">
                                            <materialDesign:PackIcon Kind="Delete" Foreground="#C62828" Width="14" Height="14" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="4">
                            <TextBlock Text="Additional Information" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding AdditionalInformation, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="70"
                                     TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                                     FontFamily="{StaticResource CairoFont}"
                                     helpers:WatermarkHelper.Watermark="معلومات إضافية عن المعايرة" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="4">
                            <TextBlock Text="Notes" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="70"
                                     TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                                     FontFamily="{StaticResource CairoFont}"
                                     helpers:WatermarkHelper.Watermark="ملاحظات ختامية" />
                        </StackPanel>
                    </Grid>

                    <!-- ═══ ٧. الاعتماد ═══ -->
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="7. Authorization &amp; Signatures" FontSize="13" FontWeight="Bold" Foreground="#C9A227" FontFamily="{StaticResource CairoFont}" />
                        <TextBlock Text="الاعتماد والتوقيعات" FontSize="11" Foreground="#9E9E9E" FontFamily="{StaticResource CairoFont}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Separator Margin="0,4,0,8" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Name" Style="{StaticResource FieldLabel}" Margin="4,0,4,4" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Title" Style="{StaticResource FieldLabel}" Margin="4,0,4,4" />
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Date" Style="{StaticResource FieldLabel}" Margin="4,0,4,4" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Calibrated By" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="4,0,10,0" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CalibratedByName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" Margin="4" helpers:WatermarkHelper.Watermark="اسم المهندس المعاير" />
                        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding CalibratedByTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" Margin="4" helpers:WatermarkHelper.Watermark="المسمّى الوظيفي" />
                        <DatePicker Grid.Row="1" Grid.Column="3" SelectedDate="{Binding CalibratedByDate}" Style="{StaticResource FieldDate}" Width="140" Margin="4" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Reviewed By" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="4,0,10,0" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ReviewedByName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" Margin="4" helpers:WatermarkHelper.Watermark="اسم المراجع" />
                        <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding ReviewedByTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" Margin="4" helpers:WatermarkHelper.Watermark="المسمّى الوظيفي" />
                        <DatePicker Grid.Row="2" Grid.Column="3" SelectedDate="{Binding ReviewedByDate}" Style="{StaticResource FieldDate}" Width="140" Margin="4" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Approved By" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="4,0,10,0" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ApprovedByName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" Margin="4" helpers:WatermarkHelper.Watermark="اسم المعتمد" />
                        <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding ApprovedByTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" Margin="4" helpers:WatermarkHelper.Watermark="المسمّى الوظيفي" />
                        <DatePicker Grid.Row="3" Grid.Column="3" SelectedDate="{Binding ApprovedByDate}" Style="{StaticResource FieldDate}" Width="140" Margin="4" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Authorized By" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="4,0,10,0" />
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding AuthorizedByName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" Margin="4" helpers:WatermarkHelper.Watermark="اسم المجيز" />
                        <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding AuthorizedByTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" Margin="4" helpers:WatermarkHelper.Watermark="المسمّى الوظيفي" />
                        <DatePicker Grid.Row="4" Grid.Column="3" SelectedDate="{Binding AuthorizedByDate}" Style="{StaticResource FieldDate}" Width="140" Margin="4" />
                    </Grid>

                </StackPanel>
            </ScrollViewer>

            <!-- التذييل -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding ValidationErrors}" Foreground="#C62828" FontSize="12"
                           VerticalAlignment="Center" TextWrapping="Wrap" FontFamily="{StaticResource CairoFont}"
                           Visibility="{Binding HasValidationErrors, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding SaveCommand}" Content="حفظ وإصدار الشهادة"
                            Style="{StaticResource MaterialDesignRaisedButton}" Background="#1A3A6B" BorderBrush="#1A3A6B"
                            Height="40" Margin="0,0,10,0" FontFamily="{StaticResource CairoFont}" />
                    <Button Content="إلغاء" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#707070"
                            BorderBrush="#E0E0E0" Height="40" Width="80" Click="CancelButton_Click"
                            FontFamily="{StaticResource CairoFont}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

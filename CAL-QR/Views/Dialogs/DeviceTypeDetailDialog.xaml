<Window x:Class="CAL_QR.Views.Dialogs.DeviceTypeDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="تفاصيل نوع الأجهزة | Device Type Details" Height="680" Width="1150"
        MinHeight="680" MinWidth="1150"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="Transparent"
        FlowDirection="RightToLeft"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border Background="{DynamicResource AppSurface}" CornerRadius="12" BorderBrush="{DynamicResource PrimaryNavy}" BorderThickness="1.5">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Header -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="تفاصيل نوع الأجهزة" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryNavy}" FontFamily="{StaticResource CairoFont}" />
                    <TextBlock Text="استعراض بيانات نوع الأجهزة وقائمة كافة الأجهزة المسجلة تحته" FontSize="11" Foreground="#707070" FontFamily="{StaticResource CairoFont}" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource MaterialDesignFlatButton}" Width="30" Height="30" Padding="0" Click="CloseButton_Click">
                    <materialDesign:PackIcon Kind="Close" Foreground="#C62828" Width="20" Height="20" />
                </Button>
            </Grid>

            <!-- Content Area -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Top Panel (Type Info Card) -->
                <Border Grid.Row="0" Background="{DynamicResource AppSurfaceAlt}" CornerRadius="8" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Padding="15" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Margin="5">
                            <TextBlock Text="نوع الجهاز" FontSize="11" Foreground="#718096" Margin="0,0,0,3" FontFamily="{StaticResource CairoFont}" />
                            <TextBlock Text="{Binding TypeInfo.Name}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryNavy}" TextWrapping="Wrap" FontFamily="{StaticResource CairoFont}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Bottom Panel (DataGrid) -->
                <Border Grid.Row="1" Background="{DynamicResource AppSurface}" CornerRadius="8" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="الأجهزة التابعة لهذا النوع" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryNavy}" Margin="5,0,0,10" FontFamily="{StaticResource CairoFont}" />

                        <DataGrid Grid.Row="1" ItemsSource="{Binding AssociatedDevices}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  Background="Transparent" BorderThickness="0" RowHeaderWidth="0" GridLinesVisibility="Horizontal"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <DataGrid.Resources>
                                <Style x:Key="CenterTextColumnStyle" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="TextAlignment" Value="Center" />
                                </Style>
                                <Style x:Key="WrapTextColumnStyle" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource UnifiedDataGridRowHoverStyle}">
                                    <Setter Property="Background" Value="{Binding RowBackground}" />
                                    <Setter Property="ToolTip" Value="انقر نقراً مزدوجاً لعرض تفاصيل الجهاز الكاملة" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <EventSetter Event="MouseDoubleClick" Handler="DataGridRow_MouseDoubleClick" />
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <!-- عمود التسلسل -->
                                <DataGridTextColumn Header="ت" Binding="{Binding SequenceNumber}" Width="45" CanUserSort="False" ElementStyle="{StaticResource CenterTextColumnStyle}">
                                    <DataGridTextColumn.HeaderTemplate>
                                        <DataTemplate><TextBlock Text="ت" FontWeight="Bold" FontFamily="{StaticResource CairoFont}" HorizontalAlignment="Center" /></DataTemplate>
                                    </DataGridTextColumn.HeaderTemplate>
                                </DataGridTextColumn>

                                <!-- عمود الجهاز والرقم التسلسلي مدمج -->
                                <DataGridTemplateColumn Width="2*">
                                    <DataGridTemplateColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="الجهاز / الرقم التسلسلي" FontWeight="Bold" FontFamily="{StaticResource CairoFont}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.HeaderTemplate>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                             <StackPanel Margin="5,2" VerticalAlignment="Center">
                                                 <TextBlock Text="{Binding Model}" FontWeight="Bold" Style="{StaticResource UnifiedNavyDataGridTextBlockStyle}" FontFamily="{StaticResource CairoFont}" />
                                                 <TextBlock Text="{Binding SerialNumber}" FontSize="10" Style="{StaticResource UnifiedSubtleDataGridTextBlockStyle}" FontFamily="{StaticResource CairoFont}" />
                                             </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- الجهة المالكة -->
                                <DataGridTextColumn Header="الجهة المالكة" Binding="{Binding OwnerName}" Width="1.5*" ElementStyle="{StaticResource WrapTextColumnStyle}">
                                    <DataGridTextColumn.HeaderTemplate>
                                        <DataTemplate><TextBlock Text="الجهة المالكة" FontWeight="Bold" FontFamily="{StaticResource CairoFont}" /></DataTemplate>
                                    </DataGridTextColumn.HeaderTemplate>
                                </DataGridTextColumn>

                                <!-- تاريخ آخر معايرة -->
                                <DataGridTextColumn Header="تاريخ آخر معايرة" Binding="{Binding LastCalibrationDateString}" Width="1.2*" ElementStyle="{StaticResource CenterTextColumnStyle}">
                                    <DataGridTextColumn.HeaderTemplate>
                                        <DataTemplate><TextBlock Text="تاريخ آخر معايرة" FontWeight="Bold" FontFamily="{StaticResource CairoFont}" HorizontalAlignment="Center" /></DataTemplate>
                                    </DataGridTextColumn.HeaderTemplate>
                                </DataGridTextColumn>

                                <!-- تاريخ الانتهاء -->
                                <DataGridTextColumn Header="تاريخ الانتهاء" Binding="{Binding ExpiryDateString}" Width="1.2*" ElementStyle="{StaticResource CenterTextColumnStyle}">
                                    <DataGridTextColumn.HeaderTemplate>
                                        <DataTemplate><TextBlock Text="تاريخ الانتهاء" FontWeight="Bold" FontFamily="{StaticResource CairoFont}" HorizontalAlignment="Center" /></DataTemplate>
                                    </DataGridTextColumn.HeaderTemplate>
                                </DataGridTextColumn>

                                <!-- حالة الصلاحية -->
                                <DataGridTemplateColumn Width="1.2*">
                                    <DataGridTemplateColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="حالة الصلاحية" FontWeight="Bold" FontFamily="{StaticResource CairoFont}" HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.HeaderTemplate>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding StatusColorHex}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource CairoFont}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Footer Actions -->
            <Grid Grid.Row="2" Margin="0,15,0,0">
                <Button Content="إغلاق" Style="{StaticResource MaterialDesignRaisedButton}" Background="{DynamicResource PrimaryNavy}" BorderBrush="{DynamicResource PrimaryNavy}" Height="40" Width="100" HorizontalAlignment="Right" Click="CloseButton_Click" FontFamily="{StaticResource CairoFont}" />
            </Grid>
        </Grid>
    </Border>
</Window>

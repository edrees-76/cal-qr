<Window x:Class="CAL_QR.Views.Dialogs.RevokeCertificateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="إلغاء الشهادة"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="{DynamicResource MaterialDesign.Brush.Background}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- تحذير -->
        <Border Grid.Row="0" Background="#FFF3CD" BorderBrush="#FFC107" BorderThickness="1"
                CornerRadius="4" Padding="12" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="⚠ تحذير — إلغاء نهائي" FontWeight="Bold" Foreground="#856404"
                           FontSize="14" Margin="0,0,0,6"/>
                <TextBlock x:Name="TxtWarning" TextWrapping="Wrap" Foreground="#664D03" FontSize="13"/>
            </StackPanel>
        </Border>

        <!-- اسم المُلغي -->
        <TextBox Grid.Row="1" x:Name="TxtRevokedBy"
                 materialDesign:HintAssist.Hint="اسم المُلغي (المسؤول)"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 Margin="0,0,0,12" FontSize="13"/>

        <!-- سبب الإلغاء -->
        <TextBox Grid.Row="2" x:Name="TxtReason"
                 materialDesign:HintAssist.Hint="سبب الإلغاء (مطلوب)"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 AcceptsReturn="False" MaxLength="500"
                 Margin="0,0,0,20" FontSize="13"/>

        <!-- أزرار -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1" Content="تأكيد الإلغاء"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#DC3545" BorderBrush="#DC3545" Foreground="White"
                    Click="ConfirmButton_Click" IsDefault="True"/>

            <Button Grid.Column="3" Content="إلغاء"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Click="CancelButton_Click" IsCancel="True"/>
        </Grid>
    </Grid>
</Window>

<Window x:Class="CAL_QR.Views.Dialogs.SignedCopyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="النسخة الموقّعة" Height="520" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="Transparent"
        FlowDirection="RightToLeft"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border Background="White" CornerRadius="12" BorderBrush="#1A3A6B" BorderThickness="1.5">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="#1A3A6B" FontFamily="{StaticResource CairoFont}">
                        <Run Text="النسخة الموقّعة — الشهادة " />
                        <Run Text="{Binding CertificateNumber, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="تُعتبر الشهادة صادرة عند إرفاق النسخة الموقّعة والمختومة فعليًّا." FontSize="11" Foreground="#707070" FontFamily="{StaticResource CairoFont}" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource MaterialDesignFlatButton}" Width="30" Height="30" Padding="0" Click="CloseButton_Click">
                    <materialDesign:PackIcon Kind="Close" Foreground="#C62828" Width="20" Height="20" />
                </Button>
            </Grid>

            <!-- Status Badge -->
            <Border Grid.Row="1" HorizontalAlignment="Right" CornerRadius="6" Padding="10,4" Margin="0,0,0,15">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#F9A825" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSignedCopyAttached}" Value="True">
                                <Setter Property="Background" Value="#2E7D32" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StatusText}" Foreground="White" FontWeight="Bold" FontSize="12" FontFamily="{StaticResource CairoFont}" />
            </Border>

            <!-- Signed Copies List -->
            <ListBox Grid.Row="2" ItemsSource="{Binding SignedCopies}" BorderThickness="1" BorderBrush="#E0E0E0" Margin="0,0,0,15">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding FileName}" VerticalAlignment="Center" FontFamily="{StaticResource CairoFont}" />
                            <Button Grid.Column="1" Style="{StaticResource MaterialDesignFlatButton}" Width="30" Height="30" Padding="0"
                                    Command="{Binding DataContext.RemoveSignedCopyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <materialDesign:PackIcon Kind="Delete" Foreground="#C62828" Width="18" Height="18" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Footer Actions -->
            <Grid Grid.Row="3" Margin="0,15,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding AddSignedCopyCommand}" Content="إرفاق نسخة موقّعة" Style="{StaticResource MaterialDesignRaisedButton}" Background="#1A3A6B" BorderBrush="#1A3A6B" Height="40" Width="150" Margin="0,0,10,0" FontFamily="{StaticResource CairoFont}" />
                    <Button Command="{Binding CloseCommand}" Content="إغلاق" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#707070" BorderBrush="#E0E0E0" Height="40" Width="80" FontFamily="{StaticResource CairoFont}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

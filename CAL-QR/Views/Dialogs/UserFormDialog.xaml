<Window x:Class="CAL_QR.Views.Dialogs.UserFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:models="clr-namespace:CAL_QR.Models"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        Title="نموذج حساب مستخدم | User Form" Height="620" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="Transparent"
        FlowDirection="RightToLeft"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <ObjectDataProvider x:Key="UserRolesEnum" MethodName="GetValues" ObjectType="{x:Type system:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:UserRole" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Border Background="White" CornerRadius="12" BorderBrush="#1A3A6B" BorderThickness="1.5">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="إدارة حسابات المستخدمين" FontSize="18" FontWeight="Bold" Foreground="#1A3A6B" FontFamily="{StaticResource CairoFont}" />
                    <TextBlock Text="إنشاء حساب مستخدم جديد وتخصيص صلاحيات العمل الخاصة به" FontSize="11" Foreground="#707070" FontFamily="{StaticResource CairoFont}" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource MaterialDesignFlatButton}" Width="30" Height="30" Padding="0" Click="CloseButton_Click">
                    <materialDesign:PackIcon Kind="Close" Foreground="#C62828" Width="20" Height="20" />
                </Button>
            </Grid>

            <!-- Form Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="5">
                    <!-- Full Name -->
                    <TextBlock Text="الاسم الكامل للمستخدم *" FontSize="12" FontWeight="Bold" Foreground="#1A3A6B" Margin="0,5,0,5" FontFamily="{StaticResource CairoFont}" />
                    <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="مثال: م. إدريس فتح الله" 
                             Height="40" Margin="0,0,0,15" FontFamily="{StaticResource CairoFont}" />

                    <!-- Username -->
                    <TextBlock Text="اسم الدخول للنظام (Username) *" FontSize="12" FontWeight="Bold" Foreground="#1A3A6B" Margin="0,5,0,5" FontFamily="{StaticResource CairoFont}" />
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="مثال: idrees_f" 
                             Height="40" Margin="0,0,0,15" FontFamily="{StaticResource CairoFont}" />

                    <!-- Password -->
                    <TextBlock Text="كلمة المرور *" FontSize="12" FontWeight="Bold" Foreground="#1A3A6B" Margin="0,5,0,5" FontFamily="{StaticResource CairoFont}" />
                    <PasswordBox x:Name="TxtPassword"
                                 Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                 materialDesign:HintAssist.Hint="أدخل كلمة مرور قوية..." 
                                 Height="40" Margin="0,0,0,15" FontFamily="{StaticResource CairoFont}" />
                    <TextBlock Text="* اترك حقل كلمة المرور فارغاً عند التعديل إذا كنت لا ترغب في تغييرها" FontSize="10" Foreground="#E65100" Margin="0,-12,0,15" Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}" FontFamily="{StaticResource CairoFont}" />

                    <!-- User Role -->
                    <TextBlock Text="دور الحساب / الصلاحية الرئيسية *" FontSize="12" FontWeight="Bold" Foreground="#1A3A6B" Margin="0,5,0,5" FontFamily="{StaticResource CairoFont}" />
                    <ComboBox ItemsSource="{Binding Source={StaticResource UserRolesEnum}}"
                              SelectedItem="{Binding Role}"
                              Style="{StaticResource MaterialDesignFilledComboBox}" 
                              Height="40" Margin="0,0,0,15" FontFamily="{StaticResource CairoFont}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontFamily="{StaticResource CairoFont}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <Trigger Property="DataContext" Value="{x:Static models:UserRole.Admin}">
                                                    <Setter Property="Text" Value="مدير النظام (صلاحيات كاملة تلقائياً)" />
                                                </Trigger>
                                                <Trigger Property="DataContext" Value="{x:Static models:UserRole.User}">
                                                    <Setter Property="Text" Value="مستخدم (صلاحيات مخصصة)" />
                                                </Trigger>
                                                <Trigger Property="DataContext" Value="{x:Static models:UserRole.Viewer}">
                                                    <Setter Property="Text" Value="مشاهد (عرض وتصفح فقط)" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Settings and Editor Flags -->
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,15">
                        <CheckBox IsChecked="{Binding IsEditor}" Content="صلاحية التعديل والكتابة (IsEditor)" 
                                  FontFamily="{StaticResource CairoFont}" FontWeight="Bold" Foreground="#1A3A6B" />
                    </StackPanel>

                    <!-- Permissions Flags Group (Collapsed if Admin) -->
                    <StackPanel x:Name="PnlPermissions" Visibility="{Binding IsNotAdminRole, Converter={StaticResource BoolToVis}}">
                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="15" Background="#F8FAFC">
                            <StackPanel>
                                <TextBlock Text="تخصيص الصلاحيات الفرعية:" FontSize="12" FontWeight="Bold" Foreground="#1A3A6B" Margin="0,0,0,10" FontFamily="{StaticResource CairoFont}" />
                                
                                <WrapPanel Margin="-8" Orientation="Horizontal">
                                    <!-- Records -->
                                    <StackPanel Orientation="Horizontal" Margin="8,8,24,8">
                                        <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}" IsChecked="{Binding CanAccessRecords}"/>
                                        <TextBlock Text="السجلات" Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource CairoFont}"/>
                                    </StackPanel>

                                    <!-- Verification -->
                                    <StackPanel Orientation="Horizontal" Margin="8,8,24,8">
                                        <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}" IsChecked="{Binding CanAccessVerification}"/>
                                        <TextBlock Text="التحقق" Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource CairoFont}"/>
                                    </StackPanel>

                                    <!-- Owners -->
                                    <StackPanel Orientation="Horizontal" Margin="8,8,24,8">
                                        <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}" IsChecked="{Binding CanAccessOwners}"/>
                                        <TextBlock Text="الجهات" Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource CairoFont}"/>
                                    </StackPanel>

                                    <!-- DeviceTypes -->
                                    <StackPanel Orientation="Horizontal" Margin="8,8,24,8">
                                        <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}" IsChecked="{Binding CanAccessDeviceTypes}"/>
                                        <TextBlock Text="الأنواع" Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource CairoFont}"/>
                                    </StackPanel>

                                    <!-- Reports -->
                                    <StackPanel Orientation="Horizontal" Margin="8,8,24,8">
                                        <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}" IsChecked="{Binding CanViewReports}"/>
                                        <TextBlock Text="التقارير والإحصائيات" Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource CairoFont}"/>
                                    </StackPanel>

                                    <!-- Settings -->
                                    <StackPanel Orientation="Horizontal" Margin="8,8,24,8">
                                        <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}" IsChecked="{Binding CanManageSettings}"/>
                                        <TextBlock Text="إعدادات النظام" Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource CairoFont}"/>
                                    </StackPanel>

                                    <!-- User Management -->
                                    <StackPanel Orientation="Horizontal" Margin="8,8,24,8">
                                        <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}" IsChecked="{Binding CanManageUsers}"/>
                                        <TextBlock Text="إدارة الحسابات والصلاحيات" Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource CairoFont}"/>
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="0,15,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Click="SaveButton_Click" Content="حفظ الحساب" Style="{StaticResource MaterialDesignRaisedButton}" Background="#1A3A6B" BorderBrush="#1A3A6B" Height="40" Width="120" Margin="0,0,10,0" FontFamily="{StaticResource CairoFont}" />
                    <Button Command="{Binding CancelCommand}" Content="إلغاء" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#707070" BorderBrush="#E0E0E0" Height="40" Width="80" FontFamily="{StaticResource CairoFont}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

<Window x:Class="CAL_QR.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="تسجيل الدخول | Login" Height="630" Width="390" MinHeight="630"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="Transparent"
        FlowDirection="RightToLeft"
        WindowStyle="None"
        AllowsTransparency="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid>
        <!-- Opaque Background to ensure no desktop shows through -->
        <Border Background="#102040" />

        <!-- Backdrop Background Image (visible when maximized) -->
        <Image Source="/Assets/Logo/magic_eraser1782906686524.png" Stretch="UniformToFill" Opacity="0.55">
            <Image.Effect>
                <BlurEffect Radius="18" RenderingBias="Quality" />
            </Image.Effect>
        </Image>
        
        <!-- Backdrop Tint Overlay -->
        <Border Background="#801A3A6B" />

        <Border Background="White" CornerRadius="12" BorderBrush="#1A3A6B" BorderThickness="1.5"
                Width="390" Height="630" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid>
                <!-- Main Login Content -->
                <Grid x:Name="GridLoginContent" Margin="20" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
 
                    <!-- Window Controls -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Style="{StaticResource MaterialDesignFlatButton}" Width="30" Height="30" Padding="0" Click="MinimizeButton_Click" ToolTip="تصغير">
                            <materialDesign:PackIcon Kind="WindowMinimize" Foreground="#707070" Width="18" Height="18" />
                        </Button>
                        <Button x:Name="BtnMaximize" Style="{StaticResource MaterialDesignFlatButton}" Width="30" Height="30" Padding="0" Click="MaximizeButton_Click" ToolTip="تكبير" Margin="5,0,0,0">
                            <materialDesign:PackIcon x:Name="IconMaximize" Kind="WindowMaximize" Foreground="#707070" Width="18" Height="18" />
                        </Button>
                        <Button Style="{StaticResource MaterialDesignFlatButton}" Width="30" Height="30" Padding="0" Click="CloseButton_Click" ToolTip="إغلاق" Margin="5,0,0,0">
                            <materialDesign:PackIcon Kind="Close" Foreground="#C62828" Width="18" Height="18" />
                        </Button>
                    </StackPanel>
 
                    <!-- Logo -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,10,0,15">
                        <Image Source="/Assets/Logo/cal-qr-logo-removebg-preview.png" Height="110" Width="110" Margin="5" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="CAL-QR" FontSize="24" FontWeight="Bold" Foreground="#1A3A6B" HorizontalAlignment="Center" FontFamily="{StaticResource CairoFont}" />
                        <TextBlock Text="نظام معايرة أجهزة المسح الإشعاعي" FontSize="14" Foreground="#707070" HorizontalAlignment="Center" Margin="0,5,0,0" FontFamily="{StaticResource CairoFont}" />
                    </StackPanel>
 
                    <!-- Fields -->
                    <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="10,0,10,0">
                        <TextBlock Text="كلمة المرور" FontSize="14" FontWeight="Bold" Foreground="#1A3A6B" Margin="0,0,0,8" Padding="0,2" FontFamily="{StaticResource CairoFont}" />
                        <Grid>
                            <PasswordBox x:Name="TxtPassword" 
                                         Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                         materialDesign:HintAssist.Hint="أدخل كلمة المرور" 
                                         materialDesign:HintAssist.IsFloating="False"
                                         Height="50"
                                         Padding="10,8,45,8"
                                         FontSize="15"
                                         FontFamily="Segoe UI"
                                         KeyDown="TxtPassword_KeyDown" />
                            <TextBox x:Name="TxtPasswordReveal" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="أدخل كلمة المرور" 
                                     materialDesign:HintAssist.IsFloating="False"
                                     Height="50"
                                     Padding="10,8,45,8"
                                     FontSize="15"
                                     FontFamily="{StaticResource CairoFont}"
                                     Visibility="Collapsed"
                                     KeyDown="TxtPassword_KeyDown" />
                            <Button x:Name="BtnRevealPassword" Click="BtnRevealPassword_Click"
                                    Style="{StaticResource MaterialDesignToolButton}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="0,0,10,0" Width="30" Height="30" Padding="0">
                                <materialDesign:PackIcon x:Name="IconRevealPassword" Kind="Eye" Width="20" Height="20" Foreground="#1A3A6B" />
                            </Button>
                        </Grid>
                        
                        <TextBlock x:Name="TxtError" Text="" Foreground="#C62828" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontFamily="{StaticResource CairoFont}" />
 
                        <Button x:Name="BtnLogin" 
                                Content="دخول" 
                                Style="{StaticResource MaterialDesignRaisedButton}" 
                                Background="#1A3A6B" 
                                BorderBrush="#1A3A6B"
                                Height="45" 
                                Margin="0,20,0,0" 
                                Click="BtnLogin_Click"
                                FontFamily="{StaticResource CairoFont}"/>
                        
                        <TextBlock Margin="0,20,0,0" HorizontalAlignment="Center" FontSize="14" Padding="0,4" FontFamily="{StaticResource CairoFont}">
                            <Hyperlink Click="ForgotPassword_Click" Foreground="#C9A227">نسيت كلمة المرور؟</Hyperlink>
                        </TextBlock>
                    </StackPanel>
 
                    <!-- Credits -->
                    <StackPanel Grid.Row="3" Margin="0,15,0,0">
                        <Separator Background="#E0E0E0" Margin="0,0,0,10" />
                        <TextBlock Text="تصميم و تطوير و تنفيد" FontSize="11" Foreground="#808080" HorizontalAlignment="Center" FontFamily="{StaticResource CairoFont}" />
                        <TextBlock Text="م . ادريس فتح الله الهرى" FontSize="11" Foreground="#808080" HorizontalAlignment="Center" Margin="0,3,0,0" FontFamily="{StaticResource CairoFont}" />
                        <TextBlock Text="م . رضا المريمى" FontSize="11" Foreground="#808080" HorizontalAlignment="Center" Margin="0,3,0,0" FontFamily="{StaticResource CairoFont}" />
                    </StackPanel>
                </Grid>

                <!-- Forgot Password Overlay -->
                <Grid x:Name="GridForgotPassword" Margin="20" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Back Button -->
                    <Button Grid.Row="0" HorizontalAlignment="Right" Style="{StaticResource MaterialDesignFlatButton}" Width="30" Height="30" Padding="0" Click="BtnBackToLogin_Click">
                        <materialDesign:PackIcon Kind="ArrowRight" Foreground="#1A3A6B" Width="20" Height="20" />
                    </Button>

                    <!-- Header Icon & Title -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,5,0,15">
                        <materialDesign:PackIcon Kind="LockReset" Foreground="#1A3A6B" Width="60" Height="60" HorizontalAlignment="Center" />
                        <TextBlock Text="استرداد كلمة المرور" FontSize="20" FontWeight="Bold" Foreground="#1A3A6B" HorizontalAlignment="Center" Margin="0,5,0,0" FontFamily="{StaticResource CairoFont}" />
                    </StackPanel>

                    <!-- Recovery Form Content -->
                    <Grid Grid.Row="2" VerticalAlignment="Center" Margin="10,0,10,0">
                        <!-- Step 1: Security Question Verification -->
                        <StackPanel x:Name="PanelVerifyQuestion" Visibility="Visible">
                            <TextBlock Text="السؤال السري للاسترداد:" FontSize="13" FontWeight="Bold" Foreground="#1A3A6B" Margin="0,0,0,8" Padding="0,2" FontFamily="{StaticResource CairoFont}"/>
                            
                            <Border Background="#F7FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12,10" Margin="0,0,0,15">
                                <TextBlock x:Name="TxtSecurityQuestion" Text="سؤال الأمان الخاص بك؟" TextWrapping="Wrap" FontSize="14" Foreground="#2D3748" FontFamily="{StaticResource CairoFont}" FontWeight="Medium"/>
                            </Border>

                            <TextBlock Text="الإجابة:" FontSize="13" FontWeight="Bold" Foreground="#1A3A6B" Margin="0,0,0,5" Padding="0,2" FontFamily="{StaticResource CairoFont}"/>
                            <TextBox x:Name="TxtSecurityAnswerInput" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="أدخل إجابة السؤال السري"
                                     materialDesign:HintAssist.IsFloating="False"
                                     Height="45"
                                     Padding="10,8"
                                     FontSize="14"
                                     FontFamily="{StaticResource CairoFont}"
                                     KeyDown="TxtSecurityAnswerInput_KeyDown"/>

                            <Button x:Name="BtnVerifyAnswer" 
                                    Content="تحقق من الإجابة" 
                                    Style="{StaticResource MaterialDesignRaisedButton}" 
                                    Background="#1A3A6B" 
                                    BorderBrush="#1A3A6B"
                                    Height="45" 
                                    Margin="0,20,0,0" 
                                    Click="BtnVerifyAnswer_Click"
                                    FontFamily="{StaticResource CairoFont}"/>
                        </StackPanel>

                        <!-- Step 2: Reset Password (Initially Collapsed) -->
                        <StackPanel x:Name="PanelResetPassword" Visibility="Collapsed">
                            <TextBlock Text="كلمة المرور الجديدة" FontSize="13" FontWeight="Bold" Foreground="#1A3A6B" Margin="0,0,0,5" Padding="0,2" FontFamily="{StaticResource CairoFont}"/>
                            <Grid>
                                <PasswordBox x:Name="TxtNewPassword" 
                                             Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                             materialDesign:HintAssist.Hint="أدخل كلمة المرور الجديدة"
                                             materialDesign:HintAssist.IsFloating="False"
                                             Height="45"
                                             Padding="10,8,45,8"
                                             FontSize="14"
                                             FontFamily="Segoe UI"/>
                                <TextBox x:Name="TxtNewPasswordReveal" 
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="أدخل كلمة المرور الجديدة"
                                         materialDesign:HintAssist.IsFloating="False"
                                         Height="45"
                                         Padding="10,8,45,8"
                                         FontSize="14"
                                         FontFamily="{StaticResource CairoFont}"
                                         Visibility="Collapsed"/>
                                <Button x:Name="BtnRevealNewPassword" Click="BtnRevealNewPassword_Click"
                                        Style="{StaticResource MaterialDesignToolButton}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="0,0,10,0" Width="30" Height="30" Padding="0">
                                    <materialDesign:PackIcon x:Name="IconRevealNewPassword" Kind="Eye" Width="20" Height="20" Foreground="#1A3A6B" />
                                </Button>
                            </Grid>

                            <TextBlock Text="تأكيد كلمة المرور الجديدة" FontSize="13" FontWeight="Bold" Foreground="#1A3A6B" Margin="0,10,0,5" Padding="0,2" FontFamily="{StaticResource CairoFont}"/>
                            <Grid>
                                <PasswordBox x:Name="TxtConfirmNewPassword" 
                                             Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                             materialDesign:HintAssist.Hint="أعد إدخال كلمة المرور لتأكيدها"
                                             materialDesign:HintAssist.IsFloating="False"
                                             Height="45"
                                             Padding="10,8,45,8"
                                             FontSize="14"
                                             FontFamily="Segoe UI"/>
                                <TextBox x:Name="TxtConfirmNewPasswordReveal" 
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="أعد إدخال كلمة المرور لتأكيدها"
                                         materialDesign:HintAssist.IsFloating="False"
                                         Height="45"
                                         Padding="10,8,45,8"
                                         FontSize="14"
                                         FontFamily="{StaticResource CairoFont}"
                                         Visibility="Collapsed"/>
                                <Button x:Name="BtnRevealConfirmNewPassword" Click="BtnRevealConfirmNewPassword_Click"
                                        Style="{StaticResource MaterialDesignToolButton}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="0,0,10,0" Width="30" Height="30" Padding="0">
                                    <materialDesign:PackIcon x:Name="IconRevealConfirmNewPassword" Kind="Eye" Width="20" Height="20" Foreground="#1A3A6B" />
                                </Button>
                            </Grid>

                            <Button x:Name="BtnSaveNewPassword" 
                                    Content="حفظ وتغيير كلمة المرور" 
                                    Style="{StaticResource MaterialDesignRaisedButton}" 
                                    Background="#2E7D32" 
                                    BorderBrush="#2E7D32"
                                    Height="45" 
                                    Margin="0,20,0,0" 
                                    Click="BtnSaveNewPassword_Click"
                                    FontFamily="{StaticResource CairoFont}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Credits -->
                    <StackPanel Grid.Row="3" Margin="0,15,0,0">
                        <Separator Background="#E0E0E0" Margin="0,0,0,10" />
                        <TextBlock Text="تصميم و تطوير و تنفيد" FontSize="11" Foreground="#808080" HorizontalAlignment="Center" FontFamily="{StaticResource CairoFont}" />
                        <TextBlock Text="م . ادريس فتح الله الهرى" FontSize="11" Foreground="#808080" HorizontalAlignment="Center" Margin="0,3,0,0" FontFamily="{StaticResource CairoFont}" />
                        <TextBlock Text="م . رضا المريمى" FontSize="11" Foreground="#808080" HorizontalAlignment="Center" Margin="0,3,0,0" FontFamily="{StaticResource CairoFont}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

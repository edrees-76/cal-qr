<Window x:Class="CAL_QR.Views.ScreensaverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="شاشة التوقف" Height="1080" Width="1920"
        WindowStyle="None"
        WindowState="Maximized"
        Topmost="True"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="#08101E">

    <Grid x:Name="RootGrid" Focusable="True">
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.45" GradientOrigin="0.5,0.45" RadiusX="0.7" RadiusY="0.7">
                <GradientStop Color="#1E3E70" Offset="0.0" />
                <GradientStop Color="#091426" Offset="0.65" />
                <GradientStop Color="#050A14" Offset="1.0" />
            </RadialGradientBrush>
        </Grid.Background>

        <!-- Dynamic Micro-glow Overlay -->
        <Border Opacity="0.08">
            <Border.Background>
                <VisualBrush TileMode="Tile" Viewport="0,0,40,40" ViewportUnits="Absolute">
                    <VisualBrush.Visual>
                        <Grid>
                            <Ellipse Width="2" Height="2" Fill="White" />
                        </Grid>
                    </VisualBrush.Visual>
                </VisualBrush>
            </Border.Background>
        </Border>

        <!-- Center Content -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,50">
            <!-- Circular Card wrapper for Logo -->
            <Grid Width="220" Height="220" HorizontalAlignment="Center" Margin="0,0,0,30">
                <!-- Outer Blue Glow -->
                <Ellipse Fill="#1A3A6B" Margin="-25" Opacity="0.25">
                    <Ellipse.Effect>
                        <BlurEffect Radius="50" />
                    </Ellipse.Effect>
                </Ellipse>
                
                <!-- White Circular Card behind Logo -->
                <Ellipse Fill="#FFFFFF" Width="210" Height="210" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="15" Direction="270" ShadowDepth="4" Opacity="0.3" />
                    </Ellipse.Effect>
                </Ellipse>
                
                <Image Source="/Assets/Logo/cal-qr-logo-removebg-preview.png"
                       Width="175" Height="175"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            </Grid>

            <!-- Main Title -->
            <TextBlock Text="نظام معايرة أجهزة المسح الإشعاعي (CAL-QR)"
                       FontFamily="{StaticResource CairoFont}"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="#FFFFFF"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,0,0,20">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="15" ShadowDepth="3" Opacity="0.75" />
                </TextBlock.Effect>
            </TextBlock>

            <!-- Complete Hierarchy Organization Text -->
            <TextBlock Text="مركز البحوث النووية"
                       FontFamily="{StaticResource CairoFont}"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="#ECEFF1"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,0,0,5" />
                       
            <TextBlock Text="إدارة الوقاية من الإشعاع"
                       FontFamily="{StaticResource CairoFont}"
                       FontSize="14.5"
                       FontWeight="SemiBold"
                       Foreground="#CFD8DC"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,0,0,5" />

            <TextBlock Text="قسم قياس وتقدير الجرعات الشخصية والمعايرة"
                       FontFamily="{StaticResource CairoFont}"
                       FontSize="13"
                       FontWeight="Medium"
                       Foreground="#C9A227"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,0,0,5" />

            <TextBlock Text="وحدة المعايرة"
                       FontFamily="{StaticResource CairoFont}"
                       FontSize="12"
                       FontWeight="Normal"
                       Foreground="#C9A227"
                       HorizontalAlignment="Center"
                       TextAlignment="Center" />
        </StackPanel>

        <!-- Bottom Action Hint -->
        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,60">
            <materialDesign:PackIcon Kind="CursorPointer" Width="24" Height="24" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,10">
                <materialDesign:PackIcon.RenderTransform>
                    <TranslateTransform x:Name="PointerTranslate" Y="0" />
                </materialDesign:PackIcon.RenderTransform>
                <materialDesign:PackIcon.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetName="PointerTranslate"
                                                 Storyboard.TargetProperty="Y"
                                                 From="0" To="-6" Duration="0:0:1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </materialDesign:PackIcon.Triggers>
            </materialDesign:PackIcon>

            <TextBlock Text="اضغط أي زر أو حرّك المؤشر للمتابعة"
                       FontFamily="{StaticResource CairoFont}"
                       FontSize="13.5"
                       Foreground="#64748B"
                       HorizontalAlignment="Center"
                       TextAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>

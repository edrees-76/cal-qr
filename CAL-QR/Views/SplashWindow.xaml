<Window x:Class="CAL_QR.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Title="CAL-QR" Height="460" Width="600">
    <Border Background="#1A3A6B" CornerRadius="15" BorderBrush="#C9A227" BorderThickness="2">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- App Logo Badge -->
            <Border Grid.Row="0" Width="130" Height="130" CornerRadius="65" Background="White" Padding="12" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
                <Image Source="/Assets/Logo/cal-qr-3d-logo-new.png" RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>

            <!-- App Title -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="10">
                <TextBlock Text="CAL-QR" FontSize="26" FontWeight="Bold" Foreground="#C9A227" HorizontalAlignment="Center" FontFamily="{StaticResource CairoFont}" />
                <TextBlock Text="نظام معايرة أجهزة المسح الإشعاعي" FontSize="18" Foreground="White" HorizontalAlignment="Center" Margin="0,5,0,0" FontFamily="{StaticResource CairoFont}" />
            </StackPanel>

            <!-- Loading Progress -->
            <ProgressBar Grid.Row="2" x:Name="ProgressBar" Height="6" Background="#0D2040" Foreground="#C9A227" IsIndeterminate="False" Minimum="0" Maximum="100" Value="10" Margin="40,20,40,10" BorderThickness="0" />

            <!-- Status Text -->
            <TextBlock Grid.Row="3" x:Name="TxtStatus" Text="جاري تشغيل النظام..." Foreground="#A0B0D0" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,10" FontFamily="{StaticResource CairoFont}" />

            <!-- Credits -->
            <StackPanel Grid.Row="4" Margin="0,10,0,0">
                <TextBlock Text="تصميم و تنفيد و تطوير" Foreground="#8090B0" FontSize="11" HorizontalAlignment="Center" FontFamily="{StaticResource CairoFont}" />
                <TextBlock Text="م . ادريس فتح الله الهرى" Foreground="#8090B0" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0" FontFamily="{StaticResource CairoFont}" />
                <TextBlock Text="م . رضا المريمى" Foreground="#8090B0" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0" FontFamily="{StaticResource CairoFont}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

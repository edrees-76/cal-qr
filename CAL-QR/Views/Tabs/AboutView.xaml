<UserControl x:Class="CAL_QR.Views.Tabs.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900"
             Background="Transparent">

    <Grid Margin="30,20,30,20" MaxWidth="800" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" /> <!-- Right Column: System info -->
            <ColumnDefinition Width="Auto" />  <!-- Middle Separator -->
            <ColumnDefinition Width="1.3*" /> <!-- Left Column: Organization & Credits -->
        </Grid.ColumnDefinitions>

        <!-- Right Column: System Info -->
        <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0,20,0">
            <!-- Logos -->
            <Image Source="/Assets/Logo/cal-qr-3d-logo-new.png" Width="120" Height="120" Margin="0,0,0,15" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />

            <!-- Separator -->
            <Border Height="2" Background="#C9A227" Margin="0,5,0,15" CornerRadius="1" />

            <!-- App Name & Version -->
            <TextBlock Text="CAL-QR" FontSize="28" FontWeight="Bold" Foreground="#1A3A6B" HorizontalAlignment="Center" FontFamily="{StaticResource CairoFont}" />
            <TextBlock Text="نظام معايرة أجهزة المسح الإشعاعي بتقنية QR" FontSize="13.5" Foreground="#4A5568" HorizontalAlignment="Center" Margin="0,5,0,5" FontFamily="{StaticResource CairoFont}" TextAlignment="Center" />
            
            <Border Background="#1A3A6B" CornerRadius="12" Padding="12,4" HorizontalAlignment="Center" Margin="0,5,0,15">
                <TextBlock Text="الإصدار: 1.0.0" FontSize="13" Foreground="White" FontFamily="{StaticResource CairoFont}" />
            </Border>

            <!-- Separator -->
            <Border Height="2" Background="#C9A227" Margin="0,5,0,15" CornerRadius="1" />

            <!-- Copyright -->
            <TextBlock Text="جميع الحقوق محفوظة © 2026" FontSize="12" Foreground="#718096" HorizontalAlignment="Center" FontFamily="{StaticResource CairoFont}" />
        </StackPanel>

        <!-- Middle Vertical Separator -->
        <Border Grid.Column="1" Width="1.5" Background="#C9A227" Margin="15,10" VerticalAlignment="Stretch" CornerRadius="1" />

        <!-- Left Column: Organization Hierarchy & Developers -->
        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,0,10,0">
            <!-- Organization Section -->
            <TextBlock Text="الجهة" FontSize="12" Foreground="#C9A227" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8" FontFamily="{StaticResource CairoFont}" />
            
            <TextBlock Text="مركز البحوث النووية - تاجوراء" FontSize="15" FontWeight="Bold" Foreground="#1A3A6B" HorizontalAlignment="Center" FontFamily="{StaticResource CairoFont}" />
            <!-- English Center Name -->
            <StackPanel FlowDirection="LeftToRight" HorizontalAlignment="Center" Margin="0,2,0,5">
                <TextBlock Text="TAJOURA NUCLEAR RESEARCH CENTER" FontSize="10.5" FontWeight="SemiBold" Foreground="#1A3A6B" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="NoWrap" FontFamily="{StaticResource CairoFont}" />
                <TextBlock Text="(TNRC)" FontSize="9.5" FontWeight="SemiBold" Foreground="#1A3A6B" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="NoWrap" Margin="0,1,0,0" FontFamily="{StaticResource CairoFont}" />
            </StackPanel>

            <TextBlock Text="إدارة الوقاية من الإشعاع" FontSize="12.5" Foreground="#4A5568" HorizontalAlignment="Center" Margin="0,3,0,3" FontFamily="{StaticResource CairoFont}" />
            
            <TextBlock Text="قسم قياس وتقدير الجرعات الشخصية والمعايرة" FontSize="12.5" Foreground="#4A5568" HorizontalAlignment="Center" Margin="0,3,0,3" FontFamily="{StaticResource CairoFont}" />
            <!-- English SSDL Name -->
            <StackPanel FlowDirection="LeftToRight" HorizontalAlignment="Center" Margin="0,2,0,5">
                <TextBlock Text="SECONDARY STANDARD DOSIMETRY LABORATORY" FontSize="10.5" FontWeight="SemiBold" Foreground="#1A3A6B" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="NoWrap" FontFamily="{StaticResource CairoFont}" />
                <TextBlock Text="(SSDL)" FontSize="9.5" FontWeight="SemiBold" Foreground="#1A3A6B" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="NoWrap" Margin="0,1,0,0" FontFamily="{StaticResource CairoFont}" />
            </StackPanel>

            <TextBlock Text="وحدة المعايرة" FontSize="12.5" Foreground="#4A5568" HorizontalAlignment="Center" Margin="0,3,0,0" FontFamily="{StaticResource CairoFont}" />

            <!-- Separator -->
            <Border Height="2" Background="#C9A227" Margin="0,15,0,10" CornerRadius="1" />

            <!-- Developer Section -->
            <TextBlock Text="تصميم و تطوير و تنفيد" FontSize="12" Foreground="#C9A227" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8" FontFamily="{StaticResource CairoFont}" />
            
            <StackPanel HorizontalAlignment="Center" Margin="0,3,0,0">
                <TextBlock Text="م . ادريس فتح الله الهرى" FontSize="14.5" FontWeight="Bold" Foreground="#1A3A6B" HorizontalAlignment="Center" FontFamily="{StaticResource CairoFont}" />
                <TextBlock Text="م . رضا المريمى" FontSize="14.5" FontWeight="Bold" Foreground="#1A3A6B" HorizontalAlignment="Center" Margin="0,4,0,8" FontFamily="{StaticResource CairoFont}" />
                
                <!-- Designer Logo Under Names -->
                <Image Source="/Assets/Logo/logo_original_4k.png" 
                       Width="80" Height="80" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>

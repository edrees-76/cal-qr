<UserControl x:Class="CAL_QR.Views.Tabs.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:CAL_QR.Views.Tabs"
             xmlns:helpers="clr-namespace:CAL_QR.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="Transparent">

    <UserControl.Resources>
        <helpers:DoubleToGridLengthConverter x:Key="DoubleToGridLengthConverter" />
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*"    />
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════
             Row 0 — Header (تدرّج كحليّ)
        ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="0" CornerRadius="8" Margin="0,0,0,10" ClipToBounds="True"
                BorderBrush="{DynamicResource AppBorder}" BorderThickness="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#0D2040" Offset="0.0" />
                    <GradientStop Color="#1A3A6B" Offset="0.65" />
                    <GradientStop Color="#1E4480" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="16,11">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="لوحة البيانات والتحليل العام"
                               FontSize="16" FontWeight="Bold" Foreground="White"
                               FontFamily="{StaticResource CairoFont}" />
                    <TextBlock Text="نظرة شاملة على حالة الأجهزة المعايرة وتوزيع الجهات والتنبيهات النشطة"
                               FontSize="11" Foreground="#A0C4F0" FontFamily="{StaticResource CairoFont}" />
                </StackPanel>

                <Border Grid.Column="1" CornerRadius="6" Background="#1EFFFFFF"
                        Padding="12,5" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Bell" Foreground="#F9A825"
                                                 Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock Text="حد التنبيه: " FontSize="11" Foreground="#C0D8F8"
                                   FontFamily="{StaticResource CairoFont}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding AlertThresholdDays}" FontSize="12" FontWeight="Bold"
                                   Foreground="#F9A825" Margin="0,0,3,0" VerticalAlignment="Center" />
                        <TextBlock Text="يوم" FontSize="11" Foreground="#C0D8F8"
                                   FontFamily="{StaticResource CairoFont}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════
             Row 1 — KPI Cards (4 بطاقات ملوّنة بتدرّج)
        ═══════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- بطاقة 1: إجمالي الأجهزة — كحليّ -->
            <Border Grid.Column="0" Margin="0,0,5,0" CornerRadius="8" Height="92" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0D2040" Offset="0.0" />
                        <GradientStop Color="#1A3A6B" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="14,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="إجمالي الأجهزة" FontSize="11" Foreground="#9ABDE8"
                                   FontFamily="{StaticResource CairoFont}" />
                        <TextBlock Text="{Binding TotalDevices}" FontSize="30" FontWeight="Bold"
                                   Foreground="White" FontFamily="{StaticResource CairoFont}" LineHeight="36" />
                        <TextBlock Text="جهاز مسجّل" FontSize="10" Foreground="#6890C0"
                                   FontFamily="{StaticResource CairoFont}" />
                    </StackPanel>
                    <materialDesign:PackIcon Grid.Column="1" Kind="Database"
                                            Width="54" Height="54" Foreground="#1EFFFFFF"
                                            VerticalAlignment="Center" Margin="6,0,0,0" />
                </Grid>
            </Border>

            <!-- بطاقة 2: سارية المفعول — أخضر -->
            <Border Grid.Column="1" Margin="5,0,5,0" CornerRadius="8" Height="92" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1B5E20" Offset="0.0" />
                        <GradientStop Color="#2E7D32" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="14,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="سارية المفعول" FontSize="11" Foreground="#A5D6A7"
                                   FontFamily="{StaticResource CairoFont}" />
                        <TextBlock Text="{Binding ValidDevices}" FontSize="30" FontWeight="Bold"
                                   Foreground="White" FontFamily="{StaticResource CairoFont}" LineHeight="36" />
                        <TextBlock Text="شهادة نشطة" FontSize="10" Foreground="#66BB6A"
                                   FontFamily="{StaticResource CairoFont}" />
                    </StackPanel>
                    <materialDesign:PackIcon Grid.Column="1" Kind="CheckCircle"
                                            Width="54" Height="54" Foreground="#1EFFFFFF"
                                            VerticalAlignment="Center" Margin="6,0,0,0" />
                </Grid>
            </Border>

            <!-- بطاقة 3: تنتهي قريباً — عنبريّ -->
            <Border Grid.Column="2" Margin="5,0,5,0" CornerRadius="8" Height="92" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#BF6000" Offset="0.0" />
                        <GradientStop Color="#F9A825" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="14,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="تنتهي قريباً" FontSize="11" Foreground="#FFF9C4"
                                   FontFamily="{StaticResource CairoFont}" />
                        <TextBlock Text="{Binding ExpiringSoonDevices}" FontSize="30" FontWeight="Bold"
                                   Foreground="White" FontFamily="{StaticResource CairoFont}" LineHeight="36" />
                        <TextBlock Text="تستحق المتابعة" FontSize="10" Foreground="#FFE082"
                                   FontFamily="{StaticResource CairoFont}" />
                    </StackPanel>
                    <materialDesign:PackIcon Grid.Column="1" Kind="AlertCircle"
                                            Width="54" Height="54" Foreground="#1EFFFFFF"
                                            VerticalAlignment="Center" Margin="6,0,0,0" />
                </Grid>
            </Border>

            <!-- بطاقة 4: منتهية الصلاحية — أحمر -->
            <Border Grid.Column="3" Margin="5,0,0,0" CornerRadius="8" Height="92" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#7F0000" Offset="0.0" />
                        <GradientStop Color="#C62828" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="14,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="منتهية الصلاحية" FontSize="11" Foreground="#FFCDD2"
                                   FontFamily="{StaticResource CairoFont}" />
                        <TextBlock Text="{Binding ExpiredDevices}" FontSize="30" FontWeight="Bold"
                                   Foreground="White" FontFamily="{StaticResource CairoFont}" LineHeight="36" />
                        <TextBlock Text="تحتاج معايرة عاجلة" FontSize="10" Foreground="#EF9A9A"
                                   FontFamily="{StaticResource CairoFont}" />
                    </StackPanel>
                    <materialDesign:PackIcon Grid.Column="1" Kind="AlertDecagram"
                                            Width="54" Height="54" Foreground="#1EFFFFFF"
                                            VerticalAlignment="Center" Margin="6,0,0,0" />
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════
             Row 2 — الجسم الرئيسيّ: الرسم البيانيّ (44%) + الجداول (56%)
        ═══════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44*" />
                <ColumnDefinition Width="56*" />
            </Grid.ColumnDefinitions>

            <!-- ── العمود الأيسر: توزيع الجهات ── -->
            <Border Grid.Column="0" Background="{DynamicResource AppSurface}" CornerRadius="8"
                    BorderBrush="{DynamicResource AppBorder}" BorderThickness="1"
                    FlowDirection="RightToLeft" ClipToBounds="True">
                <!-- شريط لونيّ علويّ (تدرّج كحليّ-ذهبيّ) -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Rectangle Grid.Row="0">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#1A3A6B" Offset="0.0" />
                                <GradientStop Color="#C9A227" Offset="1.0" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Grid Grid.Row="1" Margin="15,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- عنوان الرسم -->
                        <TextBlock Grid.Row="0" Text="توزيع الأجهزة حسب الجهات المالكة"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryNavy}"
                                   Margin="0,0,0,12" FontFamily="{StaticResource CairoFont}" />

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding OwnerDeviceStats}" VerticalAlignment="Top">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.1*" />
                                                <ColumnDefinition Width="2.4*" />
                                                <ColumnDefinition Width="35" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Rank, StringFormat={}{0}.}"
                                                           FontWeight="Bold" Foreground="{DynamicResource PrimaryNavy}"
                                                           FontSize="10.5" FontFamily="{StaticResource CairoFont}"
                                                           VerticalAlignment="Top" />
                                                <TextBlock Grid.Column="2" Text="{Binding OwnerName}"
                                                           FontSize="10.5" Foreground="#424242"
                                                           FontFamily="{StaticResource CairoFont}"
                                                           TextWrapping="Wrap" HorizontalAlignment="Stretch"
                                                           VerticalAlignment="Top" />
                                            </Grid>

                                            <!-- شريط نسبيّ بتدرّج كحليّ-ذهبيّ -->
                                            <Grid Grid.Column="1" Height="10" Margin="10,0,10,0" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding BarWidthPercentage, Converter={StaticResource DoubleToGridLengthConverter}}" />
                                                    <ColumnDefinition Width="{Binding BarWidthPercentage, Converter={StaticResource DoubleToGridLengthConverter}, ConverterParameter=Remaining}" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.ColumnSpan="2" Background="{DynamicResource AppBorder}" CornerRadius="5" />
                                                <Border Grid.Column="0" CornerRadius="5">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                            <GradientStop Color="#1A3A6B" Offset="0.0" />
                                                            <GradientStop Color="#C9A227" Offset="1.0" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </Grid>

                                            <TextBlock Grid.Column="2" Text="{Binding Count}"
                                                       FontSize="10.5" FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryNavy}"
                                                       FontFamily="{StaticResource CairoFont}"
                                                       HorizontalAlignment="Left" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <!-- ── العمود الأيمن: جدولان مكدّسان ── -->
            <Grid Grid.Column="1" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- جدول 1: تنتهي قريباً — شريط عنبريّ علويّ -->
                <Border Grid.Row="0" Background="{DynamicResource AppSurface}" CornerRadius="8"
                        BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="4" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Rectangle Grid.Row="0" Fill="#F9A825" />
                        <Grid Grid.Row="1" Margin="12,8,12,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                <materialDesign:PackIcon Kind="ClockAlert" Foreground="#F9A825"
                                                         Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="الأجهزة التي ستنتهي صلاحية معايرتها قريباً"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryNavy}"
                                           FontFamily="{StaticResource CairoFont}" VerticalAlignment="Center" />
                            </StackPanel>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding ExpiringDevices}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      Background="Transparent" BorderThickness="0" RowHeaderWidth="0"
                                      GridLinesVisibility="Horizontal">
                                <DataGrid.Resources>
                                    <Style x:Key="WrapTextColumnStyle" TargetType="TextBlock"
                                           BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                                        <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                    <Style x:Key="CenterTextColumnStyle" TargetType="TextBlock"
                                           BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                                        <Setter Property="TextAlignment" Value="Center" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource UnifiedDataGridRowHoverStyle}">
                                        <Setter Property="ToolTip" Value="انقر نقراً مزدوجاً لعرض تفاصيل الجهاز الكاملة" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <EventSetter Event="MouseDoubleClick" Handler="DataGridRow_MouseDoubleClick" />
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding Rank}" Width="40" CanUserSort="False"
                                                        ElementStyle="{StaticResource CenterTextColumnStyle}">
                                        <DataGridTextColumn.HeaderTemplate>
                                            <DataTemplate><TextBlock Text="ت" FontWeight="Bold" FontFamily="{StaticResource CairoFont}" HorizontalAlignment="Center" /></DataTemplate>
                                        </DataGridTextColumn.HeaderTemplate>
                                    </DataGridTextColumn>

                                    <DataGridTemplateColumn Width="1.4*" MinWidth="110">
                                        <DataGridTemplateColumn.HeaderTemplate>
                                            <DataTemplate><TextBlock Text="الجهاز / الرقم التسلسلي" FontWeight="Bold" FontFamily="{StaticResource CairoFont}" /></DataTemplate>
                                        </DataGridTemplateColumn.HeaderTemplate>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Vertical" Margin="0,3">
                                                    <TextBlock Text="{Binding DeviceModel}" FontWeight="Bold" FontSize="11" TextWrapping="Wrap" ToolTip="{Binding DeviceModel}" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="الرقم: " Foreground="#888888" FontSize="10" FontFamily="{StaticResource CairoFont}" />
                                                        <TextBlock Text="{Binding SerialNumber}" Foreground="#555555" FontSize="10" FontWeight="SemiBold" ToolTip="{Binding SerialNumber}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Binding="{Binding OwnerName}" Width="1.3*" MinWidth="100"
                                                        ElementStyle="{StaticResource WrapTextColumnStyle}">
                                        <DataGridTextColumn.HeaderTemplate>
                                            <DataTemplate><TextBlock Text="الجهة المالكة" FontWeight="Bold" FontFamily="{StaticResource CairoFont}" /></DataTemplate>
                                        </DataGridTextColumn.HeaderTemplate>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Binding="{Binding ExpiryDateString}" Width="1*" MinWidth="85"
                                                        ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                                        <DataGridTextColumn.HeaderTemplate>
                                            <DataTemplate><TextBlock Text="تاريخ الانتهاء" FontWeight="Bold" FontFamily="{StaticResource CairoFont}" /></DataTemplate>
                                        </DataGridTextColumn.HeaderTemplate>
                                    </DataGridTextColumn>

                                    <DataGridTemplateColumn Width="1.1*" MinWidth="95">
                                        <DataGridTemplateColumn.HeaderTemplate>
                                            <DataTemplate><TextBlock Text="الأيام المتبقية" FontWeight="Bold" FontFamily="{StaticResource CairoFont}" /></DataTemplate>
                                        </DataGridTemplateColumn.HeaderTemplate>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="ClockAlert" Foreground="#F9A825"
                                                                             Margin="0,0,5,0" Width="14" Height="14" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding DaysRemaining}" FontWeight="Bold"
                                                               Foreground="#F9A825" VerticalAlignment="Center" />
                                                    <TextBlock Text=" يوم" Foreground="#707070" FontSize="11"
                                                               Margin="3,0,0,0" VerticalAlignment="Center"
                                                               FontFamily="{StaticResource CairoFont}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- جدول 2: منتهية الصلاحية — شريط أحمر علويّ -->
                <Border Grid.Row="2" Background="{DynamicResource AppSurface}" CornerRadius="8"
                        BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="4" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Rectangle Grid.Row="0" Fill="#C62828" />
                        <Grid Grid.Row="1" Margin="12,8,12,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                <materialDesign:PackIcon Kind="AlertDecagram" Foreground="#C62828"
                                                         Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="الأجهزة منتهية الصلاحية فعلياً"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="#C62828"
                                           FontFamily="{StaticResource CairoFont}" VerticalAlignment="Center" />
                            </StackPanel>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding ExpiredDevicesList}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      Background="Transparent" BorderThickness="0" RowHeaderWidth="0"
                                      GridLinesVisibility="Horizontal">
                                <DataGrid.Resources>
                                    <Style x:Key="WrapTextColumnStyle" TargetType="TextBlock"
                                           BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                                        <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                    <Style x:Key="CenterTextColumnStyle" TargetType="TextBlock"
                                           BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                                        <Setter Property="TextAlignment" Value="Center" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource UnifiedDataGridRowHoverStyle}">
                                        <Setter Property="ToolTip" Value="انقر نقراً مزدوجاً لعرض تفاصيل الجهاز الكاملة" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <EventSetter Event="MouseDoubleClick" Handler="DataGridRow_MouseDoubleClick" />
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding Rank}" Width="40" CanUserSort="False"
                                                        ElementStyle="{StaticResource CenterTextColumnStyle}">
                                        <DataGridTextColumn.HeaderTemplate>
                                            <DataTemplate><TextBlock Text="ت" FontWeight="Bold" FontFamily="{StaticResource CairoFont}" HorizontalAlignment="Center" /></DataTemplate>
                                        </DataGridTextColumn.HeaderTemplate>
                                    </DataGridTextColumn>

                                    <DataGridTemplateColumn Width="1.4*" MinWidth="110">
                                        <DataGridTemplateColumn.HeaderTemplate>
                                            <DataTemplate><TextBlock Text="الجهاز / الرقم التسلسلي" FontWeight="Bold" FontFamily="{StaticResource CairoFont}" /></DataTemplate>
                                        </DataGridTemplateColumn.HeaderTemplate>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Vertical" Margin="0,3">
                                                    <TextBlock Text="{Binding DeviceModel}" FontWeight="Bold" FontSize="11" TextWrapping="Wrap" ToolTip="{Binding DeviceModel}" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="الرقم: " Foreground="#888888" FontSize="10" FontFamily="{StaticResource CairoFont}" />
                                                        <TextBlock Text="{Binding SerialNumber}" Foreground="#555555" FontSize="10" FontWeight="SemiBold" ToolTip="{Binding SerialNumber}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Binding="{Binding OwnerName}" Width="1.3*" MinWidth="100"
                                                        ElementStyle="{StaticResource WrapTextColumnStyle}">
                                        <DataGridTextColumn.HeaderTemplate>
                                            <DataTemplate><TextBlock Text="الجهة المالكة" FontWeight="Bold" FontFamily="{StaticResource CairoFont}" /></DataTemplate>
                                        </DataGridTextColumn.HeaderTemplate>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Binding="{Binding ExpiryDateString}" Width="1*" MinWidth="85"
                                                        ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                                        <DataGridTextColumn.HeaderTemplate>
                                            <DataTemplate><TextBlock Text="تاريخ الانتهاء" FontWeight="Bold" FontFamily="{StaticResource CairoFont}" /></DataTemplate>
                                        </DataGridTextColumn.HeaderTemplate>
                                    </DataGridTextColumn>

                                    <DataGridTemplateColumn Width="1.1*" MinWidth="95">
                                        <DataGridTemplateColumn.HeaderTemplate>
                                            <DataTemplate><TextBlock Text="الحالة" FontWeight="Bold" FontFamily="{StaticResource CairoFont}" /></DataTemplate>
                                        </DataGridTemplateColumn.HeaderTemplate>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="AlertDecagram" Foreground="#C62828"
                                                                             Margin="0,0,5,0" Width="14" Height="14" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding DaysExpiredText}" FontWeight="Bold"
                                                               Foreground="#C62828" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="CAL_QR.Views.Tabs.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:CAL_QR.Views.Tabs"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900"
             Background="Transparent">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Main Toolbar -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1" Padding="15" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Command="{Binding AddDeviceCommand}" Content="سجل جديد" Style="{StaticResource MaterialDesignRaisedButton}" Background="#2E7D32" BorderBrush="#2E7D32" Height="40" Margin="0,0,10,0" FontFamily="{StaticResource CairoFont}">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="سجل جديد" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <Button Command="{Binding ToggleViewCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#1A3A6B" BorderBrush="#1A3A6B" Height="40" Margin="0,0,10,0" FontFamily="{StaticResource CairoFont}">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ViewGrid" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="تغيير العرض" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <Button Command="{Binding PrintBatchCommand}" Content="طباعة المحدد" Style="{StaticResource MaterialDesignRaisedButton}" Background="#1A3A6B" BorderBrush="#1A3A6B" Height="40" Margin="0,0,10,0" FontFamily="{StaticResource CairoFont}">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Printer" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="طباعة المحدد" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                </StackPanel>

                <!-- Search -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="بحث سريع بالنموذج، الرقم..." 
                             Width="250" Height="40" Margin="0,0,10,0" FontFamily="{StaticResource CairoFont}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <Button Command="{Binding SearchCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#1A3A6B" BorderBrush="#1A3A6B" Height="40" Width="40" Padding="0" Margin="0,0,10,0" ToolTip="بحث">
                        <materialDesign:PackIcon Kind="Magnify" Width="20" Height="20" />
                    </Button>

                    <Button Command="{Binding ToggleAdvancedSearchCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#1A3A6B" BorderBrush="#1A3A6B" Height="40" Content="بحث متقدم" FontFamily="{StaticResource CairoFont}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Advanced Search Panel -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1" Padding="15" Margin="0,0,0,10" Visibility="{Binding IsAdvancedSearchVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Row 1 -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="5">
                        <TextBlock Text="الجهة المالكة" FontSize="11" FontWeight="Bold" Foreground="#1A3A6B" Margin="0,0,0,5" FontFamily="{StaticResource CairoFont}" />
                        <ComboBox ItemsSource="{Binding OwnersFilter}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedOwnerFilter}" Style="{StaticResource MaterialDesignOutlinedComboBox}" Height="40" FontFamily="{StaticResource CairoFont}" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="5">
                        <TextBlock Text="نوع الجهاز" FontSize="11" FontWeight="Bold" Foreground="#1A3A6B" Margin="0,0,0,5" FontFamily="{StaticResource CairoFont}" />
                        <ComboBox ItemsSource="{Binding DeviceTypesFilter}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedDeviceTypeFilter}" Style="{StaticResource MaterialDesignOutlinedComboBox}" Height="40" FontFamily="{StaticResource CairoFont}" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="5">
                        <TextBlock Text="الموديل" FontSize="11" FontWeight="Bold" Foreground="#1A3A6B" Margin="0,0,0,5" FontFamily="{StaticResource CairoFont}" />
                        <TextBox Text="{Binding FilterModel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="40" FontFamily="{StaticResource CairoFont}" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="3" Margin="5">
                        <TextBlock Text="الرقم التسلسلي" FontSize="11" FontWeight="Bold" Foreground="#1A3A6B" Margin="0,0,0,5" FontFamily="{StaticResource CairoFont}" />
                        <TextBox Text="{Binding FilterSerialNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="40" FontFamily="{StaticResource CairoFont}" />
                    </StackPanel>

                    <!-- Row 2 -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="5">
                        <TextBlock Text="تاريخ المعايرة من" FontSize="11" FontWeight="Bold" Foreground="#1A3A6B" Margin="0,0,0,5" FontFamily="{StaticResource CairoFont}" />
                        <DatePicker SelectedDate="{Binding FilterStartDate}" Style="{StaticResource MaterialDesignOutlinedDatePicker}" Height="40" FontFamily="{StaticResource CairoFont}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="5">
                        <TextBlock Text="تاريخ المعايرة إلى" FontSize="11" FontWeight="Bold" Foreground="#1A3A6B" Margin="0,0,0,5" FontFamily="{StaticResource CairoFont}" />
                        <DatePicker SelectedDate="{Binding FilterEndDate}" Style="{StaticResource MaterialDesignOutlinedDatePicker}" Height="40" FontFamily="{StaticResource CairoFont}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="5">
                        <TextBlock Text="النتيجة" FontSize="11" FontWeight="Bold" Foreground="#1A3A6B" Margin="0,0,0,5" FontFamily="{StaticResource CairoFont}" />
                        <ComboBox SelectedValue="{Binding FilterResult}" SelectedValuePath="Content" Style="{StaticResource MaterialDesignOutlinedComboBox}" Height="40" FontFamily="{StaticResource CairoFont}">
                            <ComboBoxItem Content="الكل" />
                            <ComboBoxItem Content="ناجح" />
                            <ComboBoxItem Content="راسب" />
                            <ComboBoxItem Content="مشروط" />
                            <ComboBoxItem Content="غير معاير" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="3" Margin="5">
                        <TextBlock Text="الحالة" FontSize="11" FontWeight="Bold" Foreground="#1A3A6B" Margin="0,0,0,5" FontFamily="{StaticResource CairoFont}" />
                        <ComboBox SelectedValue="{Binding FilterStatus}" SelectedValuePath="Content" Style="{StaticResource MaterialDesignOutlinedComboBox}" Height="40" FontFamily="{StaticResource CairoFont}">
                            <ComboBoxItem Content="الكل" />
                            <ComboBoxItem Content="سارية" />
                            <ComboBoxItem Content="قريبة الانتهاء" />
                            <ComboBoxItem Content="منتهية" />
                            <ComboBoxItem Content="غير معاير" />
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="5,15,5,5">
                    <Button Command="{Binding SearchCommand}" Content="تطبيق الفلترة" Style="{StaticResource MaterialDesignRaisedButton}" Background="#1A3A6B" BorderBrush="#1A3A6B" Height="36" Margin="0,0,10,0" FontFamily="{StaticResource CairoFont}" />
                    <Button Command="{Binding ClearFiltersCommand}" Content="مسح الفلاتر" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#707070" BorderBrush="#E0E0E0" Height="36" FontFamily="{StaticResource CairoFont}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="2">
            <!-- 1. Table View -->
            <Border Background="White" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1" Padding="10" Visibility="{Binding IsTableView, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DataGrid ItemsSource="{Binding Devices}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Background="Transparent" BorderThickness="0" RowHeaderWidth="0" GridLinesVisibility="Horizontal" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                            <Setter Property="Background" Value="{Binding RowBackground}" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <!-- عمود التحديد المتعدد -->
                        <DataGridTemplateColumn Width="50" IsReadOnly="False">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding DataContext.IsAllSelected, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}" ToolTip="تحديد/إلغاء تحديد الكل" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="رقم الشهادة" Binding="{Binding CertificateNumber}" Width="120" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate><TextBlock Text="رقم الشهادة" FontWeight="Bold" FontFamily="{StaticResource CairoFont}" /></DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="الجهة المالكة" Binding="{Binding OwnerName}" Width="*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate><TextBlock Text="الجهة المالكة" FontWeight="Bold" FontFamily="{StaticResource CairoFont}" /></DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="نوع الجهاز" Binding="{Binding DeviceTypeName}" Width="*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate><TextBlock Text="نوع الجهاز" FontWeight="Bold" FontFamily="{StaticResource CairoFont}" /></DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="الموديل" Binding="{Binding Model}" Width="*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate><TextBlock Text="الموديل" FontWeight="Bold" FontFamily="{StaticResource CairoFont}" /></DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="الرقم التسلسلي" Binding="{Binding SerialNumber}" Width="*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate><TextBlock Text="الرقم التسلسلي" FontWeight="Bold" FontFamily="{StaticResource CairoFont}" /></DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="تاريخ المعايرة" Binding="{Binding CalibrationDateString}" Width="110" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate><TextBlock Text="تاريخ المعايرة" FontWeight="Bold" FontFamily="{StaticResource CairoFont}" /></DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="تاريخ الانتهاء" Binding="{Binding ExpiryDateString}" Width="110" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate><TextBlock Text="تاريخ الانتهاء" FontWeight="Bold" FontFamily="{StaticResource CairoFont}" /></DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="النتيجة" Binding="{Binding ResultAr}" Width="90" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate><TextBlock Text="النتيجة" FontWeight="Bold" FontFamily="{StaticResource CairoFont}" /></DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>
                        
                        <!-- Actions -->
                        <DataGridTemplateColumn Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignToolIconButton}" Width="30" Height="30" Padding="0" ToolTip="تفاصيل تاريخ الجهاز">
                                            <materialDesign:PackIcon Kind="Eye" Foreground="#1A3A6B" Width="18" Height="18" />
                                        </Button>
                                        <Button Command="{Binding DataContext.EditDeviceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignToolIconButton}" Width="30" Height="30" Padding="0" ToolTip="تعديل">
                                            <materialDesign:PackIcon Kind="Pencil" Foreground="#C9A227" Width="18" Height="18" />
                                        </Button>
                                        <Button Command="{Binding DataContext.PrintDeviceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignToolIconButton}" Width="30" Height="30" Padding="0" ToolTip="طباعة ملصق QR">
                                            <materialDesign:PackIcon Kind="Printer" Foreground="#2E7D32" Width="18" Height="18" />
                                        </Button>
                                        <Button Command="{Binding DataContext.DeleteDeviceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignToolIconButton}" Width="30" Height="30" Padding="0" ToolTip="حذف">
                                            <materialDesign:PackIcon Kind="Delete" Foreground="#C62828" Width="18" Height="18" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- 2. Card View -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTableView}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                
                <ItemsControl ItemsSource="{Binding Devices}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <materialDesign:Card Width="265" Margin="8" Background="White" materialDesign:ElevationAssist.Elevation="Dp2" ClipToBounds="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Status Bar -->
                                    <Border Grid.Row="0" Height="6" Background="{Binding StatusColor}" />

                                    <!-- Content -->
                                    <StackPanel Grid.Row="1" Margin="15">
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding CertificateNumber}" FontSize="16" FontWeight="Bold" Foreground="#1A3A6B" FontFamily="{StaticResource CairoFont}" VerticalAlignment="Center" />
                                            <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="تحديد للطباعة الدفيعة" VerticalAlignment="Center" Margin="5,0,0,0" />
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                            <materialDesign:PackIcon Kind="OfficeBuilding" Foreground="#C9A227" Margin="0,0,5,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding OwnerName}" FontSize="12" Foreground="#424242" FontFamily="{StaticResource CairoFont}" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                            <materialDesign:PackIcon Kind="Radioactive" Foreground="#C62828" Margin="0,0,5,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding DeviceTypeName}" FontSize="12" Foreground="#424242" FontFamily="{StaticResource CairoFont}" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <materialDesign:PackIcon Kind="Laptop" Foreground="#1A3A6B" Margin="0,0,5,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Model}" FontSize="12" Foreground="#424242" FontFamily="{StaticResource CairoFont}" />
                                            <TextBlock Text=" - " Foreground="#757575" />
                                            <TextBlock Text="{Binding SerialNumber}" FontSize="12" Foreground="#757575" FontFamily="{StaticResource CairoFont}" />
                                        </StackPanel>

                                        <Separator Background="#EEEEEE" Margin="0,0,0,10" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="المعايرة" FontSize="10" Foreground="#757575" FontFamily="{StaticResource CairoFont}" />
                                                <TextBlock Text="{Binding CalibrationDateString}" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource CairoFont}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="الانتهاء" FontSize="10" Foreground="#757575" FontFamily="{StaticResource CairoFont}" />
                                                <TextBlock Text="{Binding ExpiryDateString}" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource CairoFont}" />
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                                            <Border Background="{Binding StatusColor}" CornerRadius="4" Padding="8,3" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Status}" Foreground="White" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource CairoFont}" />
                                            </Border>
                                            <Border Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                                <TextBlock Text="{Binding ResultAr}" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource CairoFont}" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Footer -->
                                    <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="#EEEEEE" BorderThickness="0,1,0,0" Padding="10,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignToolIconButton}" Width="30" Height="30" Padding="0" ToolTip="تفاصيل">
                                                    <materialDesign:PackIcon Kind="Eye" Foreground="#1A3A6B" Width="16" Height="16" />
                                                </Button>
                                                <Button Command="{Binding DataContext.EditDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignToolIconButton}" Width="30" Height="30" Padding="0" ToolTip="تعديل">
                                                    <materialDesign:PackIcon Kind="Pencil" Foreground="#C9A227" Width="16" Height="16" />
                                                </Button>
                                                <Button Command="{Binding DataContext.PrintDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignToolIconButton}" Width="30" Height="30" Padding="0" ToolTip="طباعة">
                                                    <materialDesign:PackIcon Kind="Printer" Foreground="#2E7D32" Width="16" Height="16" />
                                                </Button>
                                                <Button Command="{Binding DataContext.DeleteDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignToolIconButton}" Width="30" Height="30" Padding="0" ToolTip="حذف">
                                                    <materialDesign:PackIcon Kind="Delete" Foreground="#C62828" Width="16" Height="16" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </materialDesign:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Pagination Bar -->
        <Border Grid.Row="3" Background="White" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1" Padding="10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="حجم الصفحة:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12" FontFamily="{StaticResource CairoFont}" />
                    <ComboBox SelectedValue="{Binding PageSize}" SelectedValuePath="Content" Style="{StaticResource MaterialDesignComboBox}" Width="60" Height="25" VerticalContentAlignment="Center" FontFamily="{StaticResource CairoFont}">
                        <ComboBoxItem Content="10" />
                        <ComboBoxItem Content="20" />
                        <ComboBoxItem Content="50" />
                    </ComboBox>
                </StackPanel>

                <!-- Navigation Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,15,0" FontSize="12" FontFamily="{StaticResource CairoFont}">
                        <Run Text="الصفحة " />
                        <Run Text="{Binding CurrentPage, Mode=OneWay}" FontWeight="Bold" />
                        <Run Text=" من " />
                        <Run Text="{Binding TotalPages, Mode=OneWay}" FontWeight="Bold" />
                        <Run Text=" (إجمالي: " />
                        <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="Bold" />
                        <Run Text=" سجل)" />
                    </TextBlock>

                    <Button Command="{Binding PrevPageCommand}" Style="{StaticResource MaterialDesignFlatButton}" Width="35" Height="30" Padding="0" Margin="0,0,5,0">
                        <materialDesign:PackIcon Kind="ChevronRight" Width="20" Height="20" />
                    </Button>
                    <Button Command="{Binding NextPageCommand}" Style="{StaticResource MaterialDesignFlatButton}" Width="35" Height="30" Padding="0">
                        <materialDesign:PackIcon Kind="ChevronLeft" Width="20" Height="20" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

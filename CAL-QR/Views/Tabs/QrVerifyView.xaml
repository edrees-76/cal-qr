<UserControl x:Class="CAL_QR.Views.Tabs.QrVerifyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:CAL_QR.Views.Tabs"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="Auto" /> <!-- Quick Verify Section -->
            <RowDefinition Height="Auto" /> <!-- Paste Section Label -->
            <RowDefinition Height="*" />    <!-- Paste Section -->
            <RowDefinition Height="Auto" /> <!-- Status Banner -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1" Padding="15" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="التحقق الرقمي من صحة شهادة المعايرة" FontSize="18" FontWeight="Bold" Foreground="#1A3A6B" FontFamily="{StaticResource CairoFont}" />
                <TextBlock Text="تحليل محتويات كود QR ومطابقة التوقيع الإلكتروني المشفر لمنع التزوير" FontSize="11" Foreground="#707070" FontFamily="{StaticResource CairoFont}" />
            </StackPanel>
        </Border>

        <!-- Quick Verify Section -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1" Padding="15" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /> <!-- TextBox (Right) -->
                    <ColumnDefinition Width="Auto" /> <!-- Button (Left of TextBox) -->
                    <ColumnDefinition Width="*" />    <!-- Empty Spacer (Rest of row) -->
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="تحقق سريع بالكود" FontSize="12" FontWeight="Bold" Foreground="#1A3A6B" Margin="0,0,0,10" FontFamily="{StaticResource CairoFont}" />

                <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding QuickVerifyCode, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="أدخل كود التحقق المكتوب على الملصق" Style="{StaticResource MaterialDesignOutlinedTextBox}" Width="350" Height="40" VerticalContentAlignment="Center" FontFamily="{StaticResource CairoFont}" Margin="10,0,0,0" />

                <Button Grid.Row="1" Grid.Column="1" Command="{Binding QuickVerifyCommand}" Content="تحقق سريع" Style="{StaticResource MaterialDesignRaisedButton}" Background="#1A3A6B" BorderBrush="#1A3A6B" Height="40" FontFamily="{StaticResource CairoFont}" />
            </Grid>
        </Border>

        <!-- Paste Section Label -->
        <Grid Grid.Row="2" Margin="0,15,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="تحقق عبر لصق نص QR" FontSize="15" FontWeight="Bold" Foreground="#1A3A6B" FontFamily="{StaticResource CairoFont}" VerticalAlignment="Center" Margin="15,0,0,0" />
            <Border Grid.Column="1" Height="1" Background="#E0E0E0" VerticalAlignment="Center" />
        </Grid>

        <!-- Paste Section -->
        <Border Grid.Row="3" Background="White" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="قم بلصق النص المقروء من كاميرا QR هنا:" FontSize="12" FontWeight="Bold" Foreground="#1A3A6B" Margin="0,0,0,10" FontFamily="{StaticResource CairoFont}" />
                <TextBox Grid.Row="1" Text="{Binding ConcatenatedText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="NaN" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource CairoFont}" />

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,15,0,0">
                    <Button Command="{Binding VerifyPastedTextCommand}" Content="تحليل وتحقق" Style="{StaticResource MaterialDesignRaisedButton}" Background="#1A3A6B" BorderBrush="#1A3A6B" Height="36" Margin="0,0,10,0" FontFamily="{StaticResource CairoFont}" />
                    <Button Command="{Binding ClearCommand}" Content="مسح" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#707070" BorderBrush="#E0E0E0" Height="36" FontFamily="{StaticResource CairoFont}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Verification Status Banner -->
        <Border Grid.Row="4" CornerRadius="8" Padding="15" Margin="0,10,0,0" Visibility="{Binding IsValidated, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#F5F5F5" />
                    <Setter Property="BorderBrush" Value="#BDBDBD" />
                    <Setter Property="BorderThickness" Value="1.5" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAuthentic}" Value="True">
                            <Setter Property="Background" Value="#E8F5E9" />
                            <Setter Property="BorderBrush" Value="#A5D6A7" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsAmended}" Value="True">
                            <Setter Property="Background" Value="#FFF8E1" />
                            <Setter Property="BorderBrush" Value="#C9A227" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsNotFound}" Value="True">
                            <Setter Property="Background" Value="#FFEBEE" />
                            <Setter Property="BorderBrush" Value="#EF9A9A" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,15,0" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CheckCircle" Foreground="#2E7D32" Width="30" Height="30" Visibility="{Binding IsAuthentic, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <materialDesign:PackIcon Kind="AlertCircle" Foreground="#C9A227" Width="30" Height="30" Visibility="{Binding IsAmended, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <materialDesign:PackIcon Kind="AlertDecagram" Foreground="#C62828" Width="30" Height="30" Visibility="{Binding IsNotFound, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <materialDesign:PackIcon Kind="InformationOutline" Foreground="#707070" Width="30" Height="30" Visibility="{Binding IsUnverifiable, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Message}" FontSize="15" FontWeight="Bold" FontFamily="{StaticResource CairoFont}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#707070" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAuthentic}" Value="True">
                                            <Setter Property="Foreground" Value="#2E7D32" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsAmended}" Value="True">
                                            <Setter Property="Foreground" Value="#C9A227" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsNotFound}" Value="True">
                                            <Setter Property="Foreground" Value="#C62828" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- Certificate Data (Authentic / Amended only) -->
                <Grid Grid.Row="1" Margin="45,10,0,0" Visibility="{Binding IsSuccess, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="الجهة المالكة:" FontWeight="SemiBold" Margin="0,4" Foreground="#707070" FontFamily="{StaticResource CairoFont}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Owner}" FontWeight="Bold" Margin="10,4" Foreground="#212121" FontFamily="{StaticResource CairoFont}" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="0" Grid.Column="3" Text="رقم الشهادة:" FontWeight="SemiBold" Margin="0,4" Foreground="#707070" FontFamily="{StaticResource CairoFont}" />
                    <TextBlock Grid.Row="0" Grid.Column="4" Text="{Binding CertNo}" FontWeight="Bold" Margin="10,4" Foreground="#212121" FontFamily="{StaticResource CairoFont}" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="الموديل / الرقم التسلسلي:" FontWeight="SemiBold" Margin="0,4" Foreground="#707070" FontFamily="{StaticResource CairoFont}" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="10,4">
                        <TextBlock Text="{Binding Model}" FontWeight="Bold" Foreground="#212121" FontFamily="{StaticResource CairoFont}" TextWrapping="Wrap" />
                        <TextBlock Text=" - " Foreground="#707070" />
                        <TextBlock Text="{Binding Serial}" FontWeight="Bold" Foreground="#707070" FontFamily="{StaticResource CairoFont}" TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="3" Text="النتيجة:" FontWeight="SemiBold" Margin="0,4" Foreground="#707070" FontFamily="{StaticResource CairoFont}" />
                    <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding Result}" FontWeight="Bold" Margin="10,4" Foreground="#212121" FontFamily="{StaticResource CairoFont}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="تاريخ المعايرة / الانتهاء:" FontWeight="SemiBold" Margin="0,4" Foreground="#707070" FontFamily="{StaticResource CairoFont}" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="10,4">
                        <TextBlock Text="{Binding CalDate}" FontWeight="Bold" Foreground="#212121" FontFamily="{StaticResource CairoFont}" />
                        <TextBlock Text="  إلى  " Foreground="#707070" FontFamily="{StaticResource CairoFont}" />
                        <TextBlock Text="{Binding ExpDate}" FontWeight="Bold" Foreground="#212121" FontFamily="{StaticResource CairoFont}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="10,4" Visibility="{Binding IsAmended, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="تاريخ التعديل: " FontWeight="SemiBold" Foreground="#707070" FontFamily="{StaticResource CairoFont}" />
                        <TextBlock Text="{Binding AmendedAt}" FontWeight="Bold" Foreground="#C9A227" FontFamily="{StaticResource CairoFont}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

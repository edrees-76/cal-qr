<UserControl x:Class="CAL_QR.Views.Tabs.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:CAL_QR.Views.Tabs"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <!-- Implicit style for TextBoxes -->
        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignFilledTextBox}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#222222" />
            <Setter Property="FontFamily" Value="{StaticResource CairoFont}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Implicit style for PasswordBoxes -->
        <Style TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignFilledPasswordBox}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#222222" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Implicit style for ComboBoxes -->
        <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignFilledComboBox}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#222222" />
            <Setter Property="FontFamily" Value="{StaticResource CairoFont}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Style for Category/Section Titles -->
        <Style x:Key="SettingsSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#1A3A6B" />
            <Setter Property="Margin" Value="0,0,0,15" />
            <Setter Property="FontFamily" Value="{StaticResource CairoFont}" />
        </Style>

        <!-- Style for Field Labels -->
        <Style x:Key="SettingsLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="FontFamily" Value="{StaticResource CairoFont}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header Card -->
            <Border Grid.Row="0" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="إعدادات النظام" FontSize="18" FontWeight="Bold" Foreground="#1A3A6B" FontFamily="{StaticResource CairoFont}" />
                    <TextBlock Text="تخصيص خيارات الأمان، تنبيهات صلاحية الأجهزة، إدارة قواعد البيانات وقوالب الطباعة والنسخ الاحتياطي" FontSize="12" Foreground="#4A5568" FontFamily="{StaticResource CairoFont}" />
                </StackPanel>
            </Border>

            <!-- Settings Content Panels -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0" IsEnabled="{Binding CanEdit}">
                    <!-- Security Card -->
                    <Border Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="🔐 أمن وسلامة النظام" Style="{StaticResource SettingsSectionTitleStyle}" />

                            <!-- Current Password -->
                            <TextBlock Text="كلمة المرور الحالية" Style="{StaticResource SettingsLabelStyle}" />
                            <PasswordBox x:Name="TxtCurrentPassword" Height="40" PasswordChanged="TxtCurrentPassword_PasswordChanged" Margin="0,0,0,15" />

                            <!-- New Password -->
                            <TextBlock Text="كلمة المرور الجديدة" Style="{StaticResource SettingsLabelStyle}" />
                            <PasswordBox x:Name="TxtNewPassword" Height="40" PasswordChanged="TxtNewPassword_PasswordChanged" Margin="0,0,0,15" />

                            <!-- Confirm Password -->
                            <TextBlock Text="تأكيد كلمة المرور الجديدة" Style="{StaticResource SettingsLabelStyle}" />
                            <PasswordBox x:Name="TxtConfirmPassword" Height="40" PasswordChanged="TxtConfirmPassword_PasswordChanged" Margin="0,0,0,15" />

                            <Button Command="{Binding ChangePasswordCommand}" Content="تحديث كلمة المرور"
                                    Style="{StaticResource MaterialDesignRaisedButton}" Background="#1A3A6B" BorderBrush="#1A3A6B" Height="40" FontFamily="{StaticResource CairoFont}" />
                        </StackPanel>
                    </Border>

                    <!--
                        كلمة سرّ قسم «مفتاح التوقيع» في تبويب المساعدة.
                        المدير وحده يرى هذه البطاقة — نفس حدّ القسم نفسه.
                        ❌ لا كلمة سرّ ولا تلميح افتراضي في الكود: يُكتبان هنا فقط.
                    -->
                    <Border Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20" Margin="0,15,0,0"
                            Visibility="{Binding IsHelpSectionPasswordVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="🔑 كلمة سرّ قسم «مفتاح التوقيع»" Style="{StaticResource SettingsSectionTitleStyle}" />
                            <TextBlock Text="تحمي قسم «مفتاح التوقيع» في تبويب المساعدة. قسم «الاستعادة والطوارئ» يبقى مفتوحاً للجميع ولا تحميه هذه الكلمة."
                                       FontSize="12" Foreground="#4A5568" TextWrapping="Wrap" Margin="0,0,0,10" />

                            <TextBlock Text="{Binding HelpSectionPasswordStatusText}" FontSize="12" FontWeight="Bold" Foreground="#1A3A6B" Margin="0,0,0,12" />

                            <TextBlock Text="كلمة السرّ" Style="{StaticResource SettingsLabelStyle}" />
                            <PasswordBox x:Name="TxtHelpSectionPassword" Height="40" PasswordChanged="TxtHelpSectionPassword_PasswordChanged" Margin="0,0,0,12" />

                            <TextBlock Text="تأكيد كلمة السرّ" Style="{StaticResource SettingsLabelStyle}" />
                            <PasswordBox x:Name="TxtHelpSectionPasswordConfirm" Height="40" PasswordChanged="TxtHelpSectionPasswordConfirm_PasswordChanged" Margin="0,0,0,12" />

                            <TextBlock Text="تلميح يُعرض فوق حقل الإدخال (اختياري)" Style="{StaticResource SettingsLabelStyle}" />
                            <TextBox Text="{Binding HelpSectionPasswordHint, UpdateSourceTrigger=PropertyChanged}" Height="40" Margin="0,0,0,15" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Command="{Binding SaveHelpSectionPasswordCommand}" Content="حفظ كلمة السرّ"
                                        Style="{StaticResource MaterialDesignRaisedButton}" Background="#1A3A6B" BorderBrush="#1A3A6B" Height="40"
                                        FontFamily="{StaticResource CairoFont}" Margin="0,0,10,0" />
                                <Button Grid.Column="1" Command="{Binding ClearHelpSectionPasswordCommand}" Content="إزالة"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#D32F2F" BorderBrush="#D32F2F" Height="40" Width="100"
                                        FontFamily="{StaticResource CairoFont}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Database Paths Card -->
                    <Border Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20">
                        <StackPanel>
                            <TextBlock Text="📂 مسارات ملفات النظام" Style="{StaticResource SettingsSectionTitleStyle}" />

                            <!-- Database Path -->
                            <TextBlock Text="مسار قاعدة البيانات الفعلي (SQLite)" Style="{StaticResource SettingsLabelStyle}" />
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding DatabasePath, UpdateSourceTrigger=PropertyChanged}" Height="40" />
                                <Button Grid.Column="1" Command="{Binding BrowseDatabasePathCommand}" Content="استعراض..." Margin="10,0,0,0" Height="40"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#1A3A6B" Foreground="#1A3A6B" FontFamily="{StaticResource CairoFont}" />
                            </Grid>

                            <!-- Attachments Path -->
                            <TextBlock Text="مجلد المرفقات المرفوعة (Attachments)" Style="{StaticResource SettingsLabelStyle}" />
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding AttachmentsPath, UpdateSourceTrigger=PropertyChanged}" Height="40" />
                                <Button Grid.Column="1" Command="{Binding BrowseAttachmentsPathCommand}" Content="استعراض..." Margin="10,0,0,0" Height="40"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#1A3A6B" Foreground="#1A3A6B" FontFamily="{StaticResource CairoFont}" />
                            </Grid>

                            <!-- QrOutputPath -->
                            <TextBlock Text="مجلد حفظ رموز الاستجابة السريعة (QR Output)" Style="{StaticResource SettingsLabelStyle}" />
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding QrOutputPath, UpdateSourceTrigger=PropertyChanged}" Height="40" />
                                <Button Grid.Column="1" Command="{Binding BrowseQrOutputPathCommand}" Content="استعراض..." Margin="10,0,0,0" Height="40"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#1A3A6B" Foreground="#1A3A6B" FontFamily="{StaticResource CairoFont}" />
                            </Grid>

                            <!-- Save Paths Button -->
                            <Button Command="{Binding SavePathsCommand}" Content="حفظ مسارات النظام" 
                                    Style="{StaticResource MaterialDesignRaisedButton}" Background="#1A3A6B" BorderBrush="#1A3A6B" Height="40" FontFamily="{StaticResource CairoFont}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Column -->
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <!-- General Settings (Alerts & Auto-lock) Card -->
                    <Border Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20" Margin="0,0,0,15" IsEnabled="{Binding CanEdit}">
                        <StackPanel>
                            <TextBlock Text="⚙️ الإعدادات العامة وقفل التطبيق" Style="{StaticResource SettingsSectionTitleStyle}" />

                            <!-- Alert Days Threshold -->
                            <TextBlock Text="حد التنبيه قبل انتهاء صلاحية المعايرة (أيام)" Style="{StaticResource SettingsLabelStyle}" />
                            <TextBox Text="{Binding AlertDaysThreshold, UpdateSourceTrigger=PropertyChanged}" Height="40" Margin="0,0,0,15" />

                            <!-- Auto Lock Minutes -->
                            <TextBlock Text="مدة الإغلاق التلقائي عند خمول المستخدم (دقائق)" Style="{StaticResource SettingsLabelStyle}" />
                            <TextBox Text="{Binding AutoLockMinutes, UpdateSourceTrigger=PropertyChanged}" Height="40" Margin="0,0,0,15" />

                            <Button Command="{Binding SaveGeneralSettingsCommand}" Content="حفظ الإعدادات العامة" 
                                    Style="{StaticResource MaterialDesignRaisedButton}" Background="#1A3A6B" BorderBrush="#1A3A6B" Height="40" FontFamily="{StaticResource CairoFont}" />
                        </StackPanel>
                    </Border>

                    <!-- Printing Paper Settings Card -->
                    <Border Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20" Margin="0,0,0,15" IsEnabled="{Binding CanEdit}">
                        <StackPanel>
                            <TextBlock Text="🖨️ إعدادات ورق الطباعة" Style="{StaticResource SettingsSectionTitleStyle}" />

                            <!-- Default Printing Template -->
                            <TextBlock Text="قالب الورق والملصقات الافتراضي للطباعة" Style="{StaticResource SettingsLabelStyle}" />
                             <Grid Margin="0,0,0,10">
                                 <Grid.ColumnDefinitions>
                                     <ColumnDefinition Width="*" />
                                     <ColumnDefinition Width="Auto" />
                                     <ColumnDefinition Width="Auto" />
                                 </Grid.ColumnDefinitions>
                                 <ComboBox Grid.Column="0" ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedDefaultTemplate}" DisplayMemberPath="TemplateName" Height="40" />
                                 <Button Grid.Column="1" Command="{Binding EditTemplateCommand}" Content="✏️ تعديل" Margin="10,0,0,0" Height="40"
                                         Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#1A3A6B" Foreground="#1A3A6B" FontFamily="{StaticResource CairoFont}" />
                                 <Button Grid.Column="2" Command="{Binding NewTemplateCommand}" Content="➕ جديد" Margin="10,0,0,0" Height="40"
                                         Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#1A3A6B" Foreground="#1A3A6B" FontFamily="{StaticResource CairoFont}" />
                             </Grid>

                             <Button Command="{Binding OpenTemplatesDialogCommand}" Content="⚙️ إدارة كافة القوالب" Margin="0,0,0,15" Height="40"
                                     Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#1A3A6B" Foreground="#1A3A6B" FontFamily="{StaticResource CairoFont}" />

                             <Button Command="{Binding SavePrintTemplateCommand}" Content="حفظ قالب الطباعة الافتراضي" 
                                     Style="{StaticResource MaterialDesignRaisedButton}" Background="#2E7D32" BorderBrush="#2E7D32" Height="40" FontFamily="{StaticResource CairoFont}" />
                        </StackPanel>
                    </Border>

                    <!-- Backup Card -->
                    <Border Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20"
                            Visibility="{Binding IsBackupRestoreVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="💾 النسخ الاحتياطي والاستعادة" Style="{StaticResource SettingsSectionTitleStyle}" />

                            <!-- Backup Folder Path -->
                            <TextBlock Text="مجلد حفظ النسخ الاحتياطية" Style="{StaticResource SettingsLabelStyle}" />
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding BackupPath}" Height="40" IsReadOnly="True" />
                                <Button Grid.Column="1" Command="{Binding BrowseBackupPathCommand}" Content="تصفح..." Margin="10,0,0,0" Height="40"
                                        Style="{StaticResource MaterialDesignRaisedButton}" Background="#1A3A6B" BorderBrush="#1A3A6B" FontFamily="{StaticResource CairoFont}" />
                            </Grid>

                            <!-- Cloud Backup Path -->
                            <TextBlock Text="مجلد المزامنة السحابية (اختياري)" Style="{StaticResource SettingsLabelStyle}" />
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding CloudBackupPath}" Height="40" IsReadOnly="True" />
                                <Button Grid.Column="1" Command="{Binding BrowseCloudBackupPathCommand}" Content="تصفح..." Margin="10,0,0,0" Height="40"
                                        Style="{StaticResource MaterialDesignRaisedButton}" Background="#1A3A6B" BorderBrush="#1A3A6B" FontFamily="{StaticResource CairoFont}" />
                            </Grid>
                            <Border Background="#F0F7FF" BorderBrush="#BBDEFB" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,15">
                                <TextBlock Text="💡 اختر مجلداً داخل تطبيق مزامنة سحابي مثبّت على جهازك (مثل OneDrive أو Google Drive). سيقوم CAL-QR بنسخ الأرشيف الاحتياطي إلى هذا المجلد تلقائياً، وسيتولى تطبيق المزامنة رفعه للسحابة تلقائياً — حتى بدون اتصال إنترنت دائم، حيث يُرفع لاحقاً عند توفر الاتصال." FontSize="11" Foreground="#1565C0" TextWrapping="Wrap" FontFamily="{StaticResource CairoFont}" />
                            </Border>

                            <!-- Backup Schedule -->
                            <TextBlock Text="جدولة النسخ الاحتياطي التلقائي" Style="{StaticResource SettingsLabelStyle}" />
                            <ComboBox ItemsSource="{Binding BackupSchedules}" SelectedItem="{Binding SelectedBackupSchedule}" Height="40" Margin="0,0,0,20" />

                            <!-- Save Backup Settings Button -->
                            <Button Command="{Binding SaveGeneralSettingsCommand}" Content="حفظ إعدادات الجدولة والنسخ" Margin="0,0,0,15"
                                    Style="{StaticResource MaterialDesignRaisedButton}" Background="#2E7D32" BorderBrush="#2E7D32" Height="40" FontFamily="{StaticResource CairoFont}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Command="{Binding BackupNowCommand}" Content="نسخ احتياطي الآن 📂" Margin="0,0,5,0" Height="40"
                                        Style="{StaticResource MaterialDesignRaisedButton}" Background="#2E7D32" BorderBrush="#2E7D32" FontFamily="{StaticResource CairoFont}" />
                                <Button Grid.Column="1" Command="{Binding RestoreBackupCommand}" Content="استعادة نسخة احتياطية 🕒" Margin="5,0,0,0" Height="40"
                                        Style="{StaticResource MaterialDesignRaisedButton}" Background="#C62828" BorderBrush="#C62828" FontFamily="{StaticResource CairoFont}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Danger Zone: Full Factory Reset Card — المدير وحده يراها -->
                    <Border Background="#FFF5F5" CornerRadius="8" BorderBrush="#FEB2B2" BorderThickness="1" Padding="20" Margin="0,15,0,0"
                            Visibility="{Binding IsFactoryResetVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="⚠️ منطقة الخطر: التصفير الكامل للنظام (Factory Reset)" Style="{StaticResource SettingsSectionTitleStyle}" Foreground="#C62828" />
                            <TextBlock Text="مسح كلي شامل لكافة بيانات الأجهزة والجهات وسجلات المعايرة والملفات المرفقة وأكواد QR وسجل التدقيق، وإعادة النظام لحالة التثبيت النظيفة. المستخدمون والإعدادات تبقى. هذه العملية نهائية ولا يمكن التراجع عنها." FontSize="12" Foreground="#9B2C2C" FontFamily="{StaticResource CairoFont}" Margin="0,0,0,12" TextWrapping="Wrap" />

                            <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                                <TextBlock Text="🛡️ تُؤخذ نسخة احتياطية إجبارية قبل الحذف. لن يبدأ التصفير ما لم يكن «مجلد حفظ النسخ الاحتياطية» مضبوطاً في بطاقة النسخ الاحتياطي أعلاه." FontSize="11" Foreground="#92400E" TextWrapping="Wrap" FontFamily="{StaticResource CairoFont}" />
                            </Border>

                            <TextBlock Text="١) اكتب هذا النص بالضبط لتأكيد التصفير: RESET-ALL-DATA" FontSize="11" FontWeight="Bold" Foreground="#C62828" FontFamily="{StaticResource CairoFont}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding FactoryResetConfirmationText, UpdateSourceTrigger=PropertyChanged}" Height="40" Background="White" HorizontalContentAlignment="Center" FontFamily="Consolas, Courier New, monospace" FontWeight="Bold" Foreground="#C62828" VerticalContentAlignment="Center" Margin="0,0,0,12" />

                            <TextBlock Text="٢) أدخل كلمة سرّك الشخصية" FontSize="11" FontWeight="Bold" Foreground="#C62828" FontFamily="{StaticResource CairoFont}" Margin="0,0,0,6" />
                            <PasswordBox x:Name="TxtFactoryResetPassword" Height="40" PasswordChanged="TxtFactoryResetPassword_PasswordChanged" Margin="0,0,0,12" />

                            <Button Command="{Binding FactoryResetCommand}" Content="💥 تصفير كامل النظام" HorizontalAlignment="Stretch"
                                    Style="{StaticResource MaterialDesignRaisedButton}" Background="#C62828" BorderBrush="#C62828" Height="44" FontFamily="{StaticResource CairoFont}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>

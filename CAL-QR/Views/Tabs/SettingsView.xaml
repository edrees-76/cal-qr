<UserControl x:Class="CAL_QR.Views.Tabs.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:CAL_QR.Views.Tabs"
             xmlns:helpers="clr-namespace:CAL_QR.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="960"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <helpers:StringEqualityConverter x:Key="StringEqConv" />

        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignFilledTextBox}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontFamily" Value="{StaticResource CairoFont}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignFilledPasswordBox}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignFilledComboBox}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontFamily" Value="{StaticResource CairoFont}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Hub Card button style -->
        <Style x:Key="HubCardStyle" TargetType="RadioButton">
            <Setter Property="GroupName" Value="SettingsNav" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="CardBorder"
                                Background="White"
                                CornerRadius="10"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                Padding="16,14">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.07" Color="Black" />
                            </Border.Effect>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialDesign:PackIcon x:Name="CardIcon"
                                    Kind="{TemplateBinding Tag}"
                                    Width="32" Height="32"
                                    HorizontalAlignment="Center"
                                    Foreground="{DynamicResource PrimaryNavy}" />
                                <TextBlock x:Name="CardLabel"
                                    Text="{TemplateBinding Content}"
                                    FontSize="12" FontWeight="SemiBold"
                                    FontFamily="{StaticResource CairoFont}"
                                    Foreground="#374151"
                                    HorizontalAlignment="Center"
                                    Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource PrimaryNavy}" />
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource PrimaryNavy}" />
                                <Setter TargetName="CardIcon" Property="Foreground" Value="White" />
                                <Setter TargetName="CardLabel" Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource PrimaryNavy}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section heading style -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryNavy}" />
            <Setter Property="Margin" Value="0,0,0,18" />
            <Setter Property="FontFamily" Value="{StaticResource CairoFont}" />
        </Style>

        <!-- Field label style -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="FontFamily" Value="{StaticResource CairoFont}" />
        </Style>

        <!-- Theme swatch button style -->
        <Style x:Key="ThemeSwatchStyle" TargetType="RadioButton">
            <Setter Property="GroupName" Value="ThemeChoice" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="SwatchOuter"
                                    CornerRadius="28"
                                    BorderBrush="Transparent"
                                    BorderThickness="3"
                                    Width="56" Height="56">
                                <Border CornerRadius="22" Width="44" Height="44"
                                        Background="{TemplateBinding Background}" />
                            </Border>
                            <materialDesign:PackIcon x:Name="CheckMark"
                                Kind="Check" Width="20" Height="20"
                                Foreground="White" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwatchOuter" Property="BorderBrush" Value="{DynamicResource PrimaryNavy}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mode card style -->
        <Style x:Key="ModeCardStyle" TargetType="RadioButton">
            <Setter Property="GroupName" Value="ModeChoice" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ModeBorder"
                                CornerRadius="8" BorderThickness="2"
                                BorderBrush="#E2E8F0" Padding="14,10"
                                Background="Transparent">
                            <StackPanel HorizontalAlignment="Center">
                                <materialDesign:PackIcon x:Name="ModeIcon"
                                    Kind="{TemplateBinding Tag}"
                                    Width="24" Height="24"
                                    Foreground="#6B7280"
                                    HorizontalAlignment="Center" />
                                <TextBlock x:Name="ModeLabel"
                                    Text="{TemplateBinding Content}"
                                    FontSize="12" FontFamily="{StaticResource CairoFont}"
                                    Foreground="#6B7280"
                                    HorizontalAlignment="Center"
                                    Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ModeBorder" Property="BorderBrush" Value="{DynamicResource PrimaryNavy}" />
                                <Setter TargetName="ModeIcon" Property="Foreground" Value="{DynamicResource PrimaryNavy}" />
                                <Setter TargetName="ModeLabel" Property="Foreground" Value="{DynamicResource PrimaryNavy}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ModeBorder" Property="BorderBrush" Value="{DynamicResource PrimaryNavy}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Page header -->
            <RowDefinition Height="Auto" />  <!-- Hub cards -->
            <RowDefinition Height="*" />     <!-- Section panel -->
            <RowDefinition Height="Auto" />  <!-- Danger zone -->
        </Grid.RowDefinitions>

        <!-- ══════════ Page Header ══════════ -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,14">
            <StackPanel>
                <TextBlock Text="الإعدادات" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryNavy}" FontFamily="{StaticResource CairoFont}" />
                <TextBlock Text="اختر قسماً لتعديل إعدادات النظام" FontSize="12"
                           Foreground="#6B7280" FontFamily="{StaticResource CairoFont}" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- ══════════ Hub Cards ══════════ -->
        <UniformGrid Grid.Row="1" Rows="1" Columns="6" Margin="14,12,14,0">

            <RadioButton Style="{StaticResource HubCardStyle}"
                         Tag="Palette" Content="المظهر"
                         x:Name="CardAppearance" IsChecked="True" />

            <RadioButton Style="{StaticResource HubCardStyle}"
                         Tag="Lock" Content="الأمان"
                         x:Name="CardSecurity" />

            <RadioButton Style="{StaticResource HubCardStyle}"
                         Tag="FolderOpen" Content="المسارات"
                         x:Name="CardPaths"
                         IsEnabled="{Binding CanEdit}" />

            <RadioButton Style="{StaticResource HubCardStyle}"
                         Tag="Printer" Content="الطباعة"
                         x:Name="CardPrint"
                         IsEnabled="{Binding CanEdit}" />

            <RadioButton Style="{StaticResource HubCardStyle}"
                         Tag="DatabaseSync" Content="النسخ الاحتياطيّ"
                         x:Name="CardBackup"
                         Visibility="{Binding IsBackupRestoreVisible, Converter={StaticResource BoolToVis}}" />

            <RadioButton Style="{StaticResource HubCardStyle}"
                         Tag="CogOutline" Content="عام"
                         x:Name="CardGeneral"
                         IsEnabled="{Binding CanEdit}" />

        </UniformGrid>

        <!-- ══════════ Section Panels ══════════ -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="14,10,14,10">
            <Grid>

                <!-- ── Appearance Panel ── -->
                <Border x:Name="PanelAppearance" Background="White" CornerRadius="10"
                        BorderBrush="#E2E8F0" BorderThickness="1" Padding="24">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=CardAppearance}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="🎨 المظهر والثيم" Style="{StaticResource SectionTitle}" />

                        <!-- Palette row -->
                        <TextBlock Text="لوحة الألوان" Style="{StaticResource FieldLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <RadioButton Style="{StaticResource ThemeSwatchStyle}"
                                         Background="#162D50"
                                         IsChecked="{Binding SelectedThemeName, Converter={StaticResource StringEqConv}, ConverterParameter=Steel}"
                                         ToolTip="Steel — أزرق مدنيّ" />
                            <RadioButton Style="{StaticResource ThemeSwatchStyle}"
                                         Background="#2C3040"
                                         IsChecked="{Binding SelectedThemeName, Converter={StaticResource StringEqConv}, ConverterParameter=Gold}"
                                         ToolTip="Gold — رصاصي ذهبيّ" />
                            <RadioButton Style="{StaticResource ThemeSwatchStyle}"
                                         Background="#0D2137"
                                         IsChecked="{Binding SelectedThemeName, Converter={StaticResource StringEqConv}, ConverterParameter=Cobalt}"
                                         ToolTip="Cobalt — أزرق كهربائيّ" />
                            <RadioButton Style="{StaticResource ThemeSwatchStyle}"
                                         Background="#172818"
                                         IsChecked="{Binding SelectedThemeName, Converter={StaticResource StringEqConv}, ConverterParameter=Olive}"
                                         ToolTip="Olive — أخضر زيتوني" />

                            <!-- Colour name labels -->
                            <StackPanel Orientation="Vertical" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="13" FontFamily="{StaticResource CairoFont}" Foreground="#374151">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Steel — أزرق مدنيّ" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedThemeName}" Value="Gold">
                                                    <Setter Property="Text" Value="Gold — رصاصي ذهبيّ" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedThemeName}" Value="Cobalt">
                                                    <Setter Property="Text" Value="Cobalt — أزرق كهربائيّ" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedThemeName}" Value="Olive">
                                                    <Setter Property="Text" Value="Olive — أخضر زيتونيّ" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="اضغط «تطبيق» بعد الاختيار" FontSize="11"
                                           Foreground="#9CA3AF" FontFamily="{StaticResource CairoFont}" Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Mode row -->
                        <TextBlock Text="وضع الإضاءة" Style="{StaticResource FieldLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                            <RadioButton Style="{StaticResource ModeCardStyle}"
                                         Tag="WeatherSunny" Content="فاتح"
                                         IsChecked="{Binding AppearanceMode, Converter={StaticResource StringEqConv}, ConverterParameter=Light}" />
                            <RadioButton Style="{StaticResource ModeCardStyle}"
                                         Tag="WeatherNight" Content="داكن"
                                         IsChecked="{Binding AppearanceMode, Converter={StaticResource StringEqConv}, ConverterParameter=Dark}" />
                            <RadioButton Style="{StaticResource ModeCardStyle}"
                                         Tag="Monitor" Content="النظام"
                                         IsChecked="{Binding AppearanceMode, Converter={StaticResource StringEqConv}, ConverterParameter=System}" />
                        </StackPanel>

                        <Button Command="{Binding ApplyThemeCommand}"
                                Content="تطبيق الثيم"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{DynamicResource PrimaryNavy}"
                                BorderBrush="{DynamicResource PrimaryNavy}"
                                Height="42" Width="160"
                                HorizontalAlignment="Right"
                                FontFamily="{StaticResource CairoFont}" />
                    </StackPanel>
                </Border>

                <!-- ── Security Panel ── -->
                <Border x:Name="PanelSecurity" Background="White" CornerRadius="10"
                        BorderBrush="#E2E8F0" BorderThickness="1" Padding="24"
                        IsEnabled="{Binding CanEdit}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=CardSecurity}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Change password -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="🔐 تغيير كلمة المرور" Style="{StaticResource SectionTitle}" />

                            <TextBlock Text="كلمة المرور الحالية" Style="{StaticResource FieldLabel}" />
                            <PasswordBox x:Name="TxtCurrentPassword" Height="40" PasswordChanged="TxtCurrentPassword_PasswordChanged" Margin="0,0,0,15" />

                            <TextBlock Text="كلمة المرور الجديدة" Style="{StaticResource FieldLabel}" />
                            <PasswordBox x:Name="TxtNewPassword" Height="40" PasswordChanged="TxtNewPassword_PasswordChanged" Margin="0,0,0,15" />

                            <TextBlock Text="تأكيد كلمة المرور الجديدة" Style="{StaticResource FieldLabel}" />
                            <PasswordBox x:Name="TxtConfirmPassword" Height="40" PasswordChanged="TxtConfirmPassword_PasswordChanged" Margin="0,0,0,20" />

                            <Button Command="{Binding ChangePasswordCommand}" Content="تحديث كلمة المرور"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="{DynamicResource PrimaryNavy}" BorderBrush="{DynamicResource PrimaryNavy}"
                                    Height="40" FontFamily="{StaticResource CairoFont}" />
                        </StackPanel>

                        <!-- Help section password (admin only) -->
                        <StackPanel Grid.Column="2"
                                    Visibility="{Binding IsHelpSectionPasswordVisible, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="🔑 كلمة سرّ «مفتاح التوقيع»" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="تحمي قسم «مفتاح التوقيع» في تبويب المساعدة."
                                       FontSize="12" Foreground="#6B7280" TextWrapping="Wrap"
                                       FontFamily="{StaticResource CairoFont}" Margin="0,0,0,10" />
                            <TextBlock Text="{Binding HelpSectionPasswordStatusText}"
                                       FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryNavy}" Margin="0,0,0,12" />

                            <TextBlock Text="كلمة السرّ" Style="{StaticResource FieldLabel}" />
                            <PasswordBox x:Name="TxtHelpSectionPassword" Height="40" PasswordChanged="TxtHelpSectionPassword_PasswordChanged" Margin="0,0,0,12" />

                            <TextBlock Text="تأكيد كلمة السرّ" Style="{StaticResource FieldLabel}" />
                            <PasswordBox x:Name="TxtHelpSectionPasswordConfirm" Height="40" PasswordChanged="TxtHelpSectionPasswordConfirm_PasswordChanged" Margin="0,0,0,12" />

                            <TextBlock Text="تلميح (اختياري)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding HelpSectionPasswordHint, UpdateSourceTrigger=PropertyChanged}" Height="40" Margin="0,0,0,15" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Command="{Binding SaveHelpSectionPasswordCommand}" Content="حفظ كلمة السرّ"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="{DynamicResource PrimaryNavy}" BorderBrush="{DynamicResource PrimaryNavy}"
                                        Height="40" FontFamily="{StaticResource CairoFont}" Margin="0,0,10,0" />
                                <Button Grid.Column="1" Command="{Binding ClearHelpSectionPasswordCommand}" Content="إزالة"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Foreground="#D32F2F" BorderBrush="#D32F2F" Height="40" Width="100"
                                        FontFamily="{StaticResource CairoFont}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── Paths Panel ── -->
                <Border x:Name="PanelPaths" Background="White" CornerRadius="10"
                        BorderBrush="#E2E8F0" BorderThickness="1" Padding="24"
                        IsEnabled="{Binding CanEdit}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=CardPaths}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel MaxWidth="600" HorizontalAlignment="Right">
                        <TextBlock Text="📂 مسارات ملفات النظام" Style="{StaticResource SectionTitle}" />

                        <TextBlock Text="مسار قاعدة البيانات (SQLite)" Style="{StaticResource FieldLabel}" />
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding DatabasePath, UpdateSourceTrigger=PropertyChanged}" Height="40" />
                            <Button Grid.Column="1" Command="{Binding BrowseDatabasePathCommand}" Content="استعراض…" Margin="10,0,0,0" Height="40"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    BorderBrush="{DynamicResource PrimaryNavy}" Foreground="{DynamicResource PrimaryNavy}"
                                    FontFamily="{StaticResource CairoFont}" />
                        </Grid>

                        <TextBlock Text="مجلد المرفقات" Style="{StaticResource FieldLabel}" />
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding AttachmentsPath, UpdateSourceTrigger=PropertyChanged}" Height="40" />
                            <Button Grid.Column="1" Command="{Binding BrowseAttachmentsPathCommand}" Content="استعراض…" Margin="10,0,0,0" Height="40"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    BorderBrush="{DynamicResource PrimaryNavy}" Foreground="{DynamicResource PrimaryNavy}"
                                    FontFamily="{StaticResource CairoFont}" />
                        </Grid>

                        <TextBlock Text="مجلد مخرجات QR" Style="{StaticResource FieldLabel}" />
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding QrOutputPath, UpdateSourceTrigger=PropertyChanged}" Height="40" />
                            <Button Grid.Column="1" Command="{Binding BrowseQrOutputPathCommand}" Content="استعراض…" Margin="10,0,0,0" Height="40"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    BorderBrush="{DynamicResource PrimaryNavy}" Foreground="{DynamicResource PrimaryNavy}"
                                    FontFamily="{StaticResource CairoFont}" />
                        </Grid>

                        <Button Command="{Binding SavePathsCommand}" Content="حفظ المسارات"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{DynamicResource PrimaryNavy}" BorderBrush="{DynamicResource PrimaryNavy}"
                                Height="40" HorizontalAlignment="Right" Width="160" FontFamily="{StaticResource CairoFont}" />
                    </StackPanel>
                </Border>

                <!-- ── Print Panel ── -->
                <Border x:Name="PanelPrint" Background="White" CornerRadius="10"
                        BorderBrush="#E2E8F0" BorderThickness="1" Padding="24"
                        IsEnabled="{Binding CanEdit}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=CardPrint}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel MaxWidth="600" HorizontalAlignment="Right">
                        <TextBlock Text="🖨️ إعدادات ورق الطباعة" Style="{StaticResource SectionTitle}" />

                        <TextBlock Text="قالب الورق والملصقات الافتراضيّ" Style="{StaticResource FieldLabel}" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedDefaultTemplate}"
                                      DisplayMemberPath="TemplateName" Height="40" />
                            <Button Grid.Column="1" Command="{Binding EditTemplateCommand}" Content="✏️ تعديل" Margin="10,0,0,0" Height="40"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    BorderBrush="{DynamicResource PrimaryNavy}" Foreground="{DynamicResource PrimaryNavy}"
                                    FontFamily="{StaticResource CairoFont}" />
                            <Button Grid.Column="2" Command="{Binding NewTemplateCommand}" Content="➕ جديد" Margin="10,0,0,0" Height="40"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    BorderBrush="{DynamicResource PrimaryNavy}" Foreground="{DynamicResource PrimaryNavy}"
                                    FontFamily="{StaticResource CairoFont}" />
                        </Grid>

                        <Button Command="{Binding OpenTemplatesDialogCommand}" Content="⚙️ إدارة كافة القوالب" Margin="0,0,0,20" Height="40"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                BorderBrush="{DynamicResource PrimaryNavy}" Foreground="{DynamicResource PrimaryNavy}"
                                FontFamily="{StaticResource CairoFont}" HorizontalAlignment="Right" />

                        <Button Command="{Binding SavePrintTemplateCommand}" Content="حفظ القالب الافتراضيّ"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#2E7D32" BorderBrush="#2E7D32"
                                Height="40" HorizontalAlignment="Right" Width="200" FontFamily="{StaticResource CairoFont}" />
                    </StackPanel>
                </Border>

                <!-- ── Backup Panel ── -->
                <Border x:Name="PanelBackup" Background="White" CornerRadius="10"
                        BorderBrush="#E2E8F0" BorderThickness="1" Padding="24">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=CardBackup}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: paths + schedule + actions -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="💾 النسخ الاحتياطيّ والاستعادة" Style="{StaticResource SectionTitle}" />

                            <TextBlock Text="مجلد النسخ الاحتياطيّة" Style="{StaticResource FieldLabel}" />
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding BackupPath}" Height="40" IsReadOnly="True" />
                                <Button Grid.Column="1" Command="{Binding BrowseBackupPathCommand}" Content="تصفح…" Margin="10,0,0,0" Height="40"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="{DynamicResource PrimaryNavy}" BorderBrush="{DynamicResource PrimaryNavy}"
                                        FontFamily="{StaticResource CairoFont}" />
                            </Grid>

                            <TextBlock Text="مجلد المزامنة السحابيّة (اختياريّ)" Style="{StaticResource FieldLabel}" />
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding CloudBackupPath}" Height="40" IsReadOnly="True" />
                                <Button Grid.Column="1" Command="{Binding BrowseCloudBackupPathCommand}" Content="تصفح…" Margin="10,0,0,0" Height="40"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="{DynamicResource PrimaryNavy}" BorderBrush="{DynamicResource PrimaryNavy}"
                                        FontFamily="{StaticResource CairoFont}" />
                            </Grid>

                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                                    CornerRadius="6" Padding="10,8" Margin="0,0,0,15">
                                <TextBlock Text="💡 اختر مجلداً داخل OneDrive أو Google Drive. سيرفع تطبيق المزامنة النسخة تلقائياً."
                                           FontSize="11" Foreground="#1D4ED8" TextWrapping="Wrap"
                                           FontFamily="{StaticResource CairoFont}" />
                            </Border>

                            <TextBlock Text="الجدولة التلقائيّة" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding BackupSchedules}" SelectedItem="{Binding SelectedBackupSchedule}"
                                      Height="40" Margin="0,0,0,15" />

                            <Button Command="{Binding SaveGeneralSettingsCommand}" Content="حفظ إعدادات الجدولة"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="#2E7D32" BorderBrush="#2E7D32" Height="40"
                                    FontFamily="{StaticResource CairoFont}" Margin="0,0,0,15" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Command="{Binding BackupNowCommand}" Content="نسخ الآن 📂" Margin="0,0,5,0" Height="40"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="#2E7D32" BorderBrush="#2E7D32" FontFamily="{StaticResource CairoFont}" />
                                <Button Grid.Column="1" Command="{Binding RestoreBackupCommand}" Content="استعادة نسخة 🕒" Margin="5,0,0,0" Height="40"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="#C62828" BorderBrush="#C62828" FontFamily="{StaticResource CairoFont}" />
                            </Grid>
                        </StackPanel>

                        <!-- Right: backup password -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="🔒 كلمة سرّ النسخ الاحتياطيّ" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding BackupPasswordStatusText}"
                                       FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryNavy}"
                                       Margin="0,0,0,8" TextWrapping="Wrap" FontFamily="{StaticResource CairoFont}" />
                            <TextBlock Text="تُقفل بها كلّ نسخة. اكتبها على ورقة واحفظها في ظرف مختوم."
                                       FontSize="12" Foreground="#6B7280" TextWrapping="Wrap"
                                       FontFamily="{StaticResource CairoFont}" Margin="0,0,0,15" />

                            <TextBlock Text="كلمة السرّ (10 محارف على الأقل)" Style="{StaticResource FieldLabel}" />
                            <PasswordBox x:Name="TxtBackupPassword" Height="40" PasswordChanged="TxtBackupPassword_PasswordChanged" Margin="0,0,0,12" />

                            <TextBlock Text="تأكيد كلمة السرّ" Style="{StaticResource FieldLabel}" />
                            <PasswordBox x:Name="TxtBackupPasswordConfirm" Height="40" PasswordChanged="TxtBackupPasswordConfirm_PasswordChanged" Margin="0,0,0,15" />

                            <Button Command="{Binding SaveBackupPasswordCommand}" Content="حفظ كلمة سرّ النسخ"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="{DynamicResource PrimaryNavy}" BorderBrush="{DynamicResource PrimaryNavy}"
                                    Height="40" FontFamily="{StaticResource CairoFont}" Margin="0,0,0,20" />

                            <TextBlock Text="كلمة سرّ النسخة المُستعادة (فارغة = كلمة هذا الجهاز)"
                                       Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                            <PasswordBox x:Name="TxtRestorePassword" Height="40" PasswordChanged="TxtRestorePassword_PasswordChanged" Margin="0,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── General Panel ── -->
                <Border x:Name="PanelGeneral" Background="White" CornerRadius="10"
                        BorderBrush="#E2E8F0" BorderThickness="1" Padding="24"
                        IsEnabled="{Binding CanEdit}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=CardGeneral}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel MaxWidth="500" HorizontalAlignment="Right">
                        <TextBlock Text="⚙️ الإعدادات العامة" Style="{StaticResource SectionTitle}" />

                        <TextBlock Text="حد التنبيه قبل انتهاء صلاحية المعايرة (أيام)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding AlertDaysThreshold, UpdateSourceTrigger=PropertyChanged}"
                                 Height="40" Margin="0,0,0,15" />

                        <TextBlock Text="مدة الإغلاق التلقائيّ عند الخمول (دقائق)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding AutoLockMinutes, UpdateSourceTrigger=PropertyChanged}"
                                 Height="40" Margin="0,0,0,20" />

                        <Button Command="{Binding SaveGeneralSettingsCommand}" Content="حفظ الإعدادات العامة"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{DynamicResource PrimaryNavy}" BorderBrush="{DynamicResource PrimaryNavy}"
                                Height="40" HorizontalAlignment="Right" Width="180" FontFamily="{StaticResource CairoFont}" />
                    </StackPanel>
                </Border>

            </Grid>
        </ScrollViewer>

        <!-- ══════════ Danger Zone (Admin only) ══════════ -->
        <Border Grid.Row="3" Margin="14,0,14,12"
                Background="#FFF5F5" CornerRadius="10"
                BorderBrush="#FEB2B2" BorderThickness="1" Padding="20"
                Visibility="{Binding IsFactoryResetVisible, Converter={StaticResource BoolToVis}}">
            <Expander Header="⚠️ منطقة الخطر: التصفير الكامل للنظام"
                      Foreground="#C62828"
                      FontFamily="{StaticResource CairoFont}"
                      FontSize="13" FontWeight="Bold">
                <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="مسح كليّ شامل لكافة بيانات المعايرة والملفات وسجلات التدقيق وإعادة النظام لحالة التثبيت النظيفة. لا يمكن التراجع."
                               FontSize="12" Foreground="#9B2C2C" TextWrapping="Wrap"
                               FontFamily="{StaticResource CairoFont}" Margin="0,0,0,10" />

                    <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1"
                            CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                        <TextBlock Text="🛡️ تُؤخذ نسخة احتياطية إجبارية قبل الحذف. يُشترط ضبط «مجلد النسخ الاحتياطيّة» أوّلاً."
                                   FontSize="11" Foreground="#92400E" TextWrapping="Wrap"
                                   FontFamily="{StaticResource CairoFont}" />
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="1) اكتب: RESET-ALL-DATA" FontSize="11" FontWeight="Bold"
                                       Foreground="#C62828" FontFamily="{StaticResource CairoFont}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding FactoryResetConfirmationText, UpdateSourceTrigger=PropertyChanged}"
                                     Height="40" HorizontalContentAlignment="Center"
                                     FontFamily="Consolas, Courier New, monospace"
                                     FontWeight="Bold" Foreground="#C62828" VerticalContentAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="2) أدخل كلمة سرّك الشخصية" FontSize="11" FontWeight="Bold"
                                       Foreground="#C62828" FontFamily="{StaticResource CairoFont}" Margin="0,0,0,6" />
                            <PasswordBox x:Name="TxtFactoryResetPassword" Height="40"
                                         PasswordChanged="TxtFactoryResetPassword_PasswordChanged" />
                        </StackPanel>
                    </Grid>

                    <Button Command="{Binding FactoryResetCommand}" Content="💥 تصفير كامل النظام"
                            HorizontalAlignment="Stretch" Margin="0,12,0,0"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#C62828" BorderBrush="#C62828"
                            Height="44" FontFamily="{StaticResource CairoFont}" />
                </StackPanel>
            </Expander>
        </Border>

    </Grid>
</UserControl>

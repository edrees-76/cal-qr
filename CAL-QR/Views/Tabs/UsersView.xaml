<UserControl x:Class="CAL_QR.Views.Tabs.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:CAL_QR.Views.Tabs"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="إدارة حسابات المستخدمين والصلاحيات" FontSize="18" FontWeight="Bold" Foreground="#1A3A6B" FontFamily="{StaticResource CairoFont}" />
                    <TextBlock Text="التحكم في مستخدمي النظام وتوزيع الصلاحيات ومراقبة سجل نشاطاتهم" FontSize="11" Foreground="#718096" FontFamily="{StaticResource CairoFont}" />
                </StackPanel>
                
                <materialDesign:PackIcon Grid.Column="1" Kind="ShieldAccount" Width="36" Height="36" Foreground="#1A3A6B" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Main Tabs Control -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0">
            <!-- Tab 1: Accounts List -->
            <TabItem Header="قائمة الحسابات" FontFamily="{StaticResource CairoFont}" FontSize="13" FontWeight="Bold">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Control Panel (Search and Add) -->
                    <Border Grid.Row="0" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Search -->
                            <Grid Grid.Column="0" HorizontalAlignment="Left" Width="350">
                                <materialDesign:ColorZone Mode="Light" CornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp1" Height="38">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Kind="Magnify" Foreground="#707070" Width="20" Height="20" Margin="10,0" VerticalAlignment="Center" />
                                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                                 Grid.Column="1" 
                                                 materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" 
                                                 BorderThickness="0" 
                                                 VerticalAlignment="Center" 
                                                 materialDesign:HintAssist.Hint="بحث باسم المستخدم أو الاسم الكامل..." 
                                                 FontFamily="{StaticResource CairoFont}" 
                                                 Height="30" 
                                                 VerticalContentAlignment="Center" />
                                    </Grid>
                                </materialDesign:ColorZone>
                            </Grid>

                            <!-- Add User Button -->
                            <Button Grid.Column="1" Command="{Binding AddUserCommand}" Style="{StaticResource MaterialDesignRaisedButton}" 
                                    Background="#1A3A6B" BorderBrush="#1A3A6B" Height="38" Padding="15,0" FontFamily="{StaticResource CairoFont}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AccountPlus" Width="18" Height="18" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="إضافة مستخدم جديد" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Accounts Grid -->
                    <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10">
                        <DataGrid ItemsSource="{Binding Users}" AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="Transparent" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                  BorderThickness="0" RowHeight="42" FontFamily="{StaticResource CairoFont}">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                    <Setter Property="Foreground" Value="#1A3A6B"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="10,5"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="FontFamily" Value="{StaticResource CairoFont}"/>
                                    <Setter Property="FontSize" Value="12"/>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="10,2"/>
                                    <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الاسم الكامل" Binding="{Binding FullName}" Width="2*" />
                                <DataGridTextColumn Header="اسم المستخدم" Binding="{Binding Username}" Width="1.5*" />
                                <DataGridTextColumn Header="الدور الرئيسي" Binding="{Binding RoleDisplayName}" Width="1.2*" />
                                <DataGridTextColumn Header="حالة التعديل" Binding="{Binding IsEditorDisplayName}" Width="1*" />
                                
                                <!-- Custom columns helper for Editor -->
                                <DataGridTemplateColumn Header="صلاحية الكتابة" Width="1*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsEditor}" IsHitTestVisible="False" HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="الحالة" Width="1.2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Background" Value="#E8F5E9" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Background" Value="#FFEBEE" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontWeight="Bold" FontFamily="{StaticResource CairoFont}" FontSize="11">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Text" Value="نشط" />
                                                                    <Setter Property="Foreground" Value="#2E7D32" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Text" Value="موقوف" />
                                                                    <Setter Property="Foreground" Value="#C62828" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="آخر تسجيل دخول" Binding="{Binding LastLoginAt, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}" Width="1.8*" />

                                <!-- Actions -->
                                <DataGridTemplateColumn Header="إجراءات" Width="1.8*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <!-- Edit -->
                                                <Button Command="{Binding DataContext.EditUserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignFlatButton}" Width="32" Height="32" Padding="0" Margin="0,0,5,0" ToolTip="تعديل الحساب">
                                                    <materialDesign:PackIcon Kind="Pencil" Foreground="#1A3A6B" Width="16" Height="16" />
                                                </Button>

                                                <!-- Freeze/Activate Toggle -->
                                                <Button Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                        CommandParameter="{Binding}"
                                                        Width="32" Height="32" Padding="0" ToolTip="تجميد أو تفعيل الحساب">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Content">
                                                                        <Setter.Value>
                                                                            <materialDesign:PackIcon Kind="AccountCancel" Foreground="#C62828" Width="16" Height="16" />
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Content">
                                                                        <Setter.Value>
                                                                            <materialDesign:PackIcon Kind="AccountCheck" Foreground="#2E7D32" Width="16" Height="16" />
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 2: User Logs Timeline -->
            <TabItem Header="سجل العمليات والأحداث" FontFamily="{StaticResource CairoFont}" FontSize="13" FontWeight="Bold"
                     Visibility="{Binding IsAuditLogTabVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Filters Panel -->
                    <Border Grid.Row="0" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="15" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- User Picker -->
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="مستلم العملية" FontSize="11" Foreground="#718096" Margin="0,0,0,5" FontFamily="{StaticResource CairoFont}" />
                                <ComboBox ItemsSource="{Binding FilterUsers}" SelectedItem="{Binding SelectedFilterUser}"
                                          DisplayMemberPath="FullName" SelectedValuePath="Id"
                                          Style="{StaticResource MaterialDesignFilledComboBox}" Height="40" FontFamily="{StaticResource CairoFont}" />
                            </StackPanel>

                            <!-- Start Date -->
                            <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                <TextBlock Text="من تاريخ" FontSize="11" Foreground="#718096" Margin="0,0,0,5" FontFamily="{StaticResource CairoFont}" />
                                <DatePicker SelectedDate="{Binding StartDate}" materialDesign:HintAssist.Hint="اختر التاريخ..."
                                            Style="{StaticResource MaterialDesignFilledDatePicker}" Height="40" FontFamily="{StaticResource CairoFont}" />
                            </StackPanel>

                            <!-- End Date -->
                            <StackPanel Grid.Column="2" Margin="10,0,10,0">
                                <TextBlock Text="إلى تاريخ" FontSize="11" Foreground="#718096" Margin="0,0,0,5" FontFamily="{StaticResource CairoFont}" />
                                <DatePicker SelectedDate="{Binding EndDate}" materialDesign:HintAssist.Hint="اختر التاريخ..."
                                            Style="{StaticResource MaterialDesignFilledDatePicker}" Height="40" FontFamily="{StaticResource CairoFont}" />
                            </StackPanel>

                            <!-- Reload Actions -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Command="{Binding ClearCommand}" Content="إعادة تعيين 🔄" Height="40"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#718096" Foreground="#718096" FontFamily="{StaticResource CairoFont}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Logs Table -->
                    <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10">
                        <DataGrid ItemsSource="{Binding Logs}" AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="Transparent" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                  BorderThickness="0" RowHeight="38" FontFamily="{StaticResource CairoFont}">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                    <Setter Property="Foreground" Value="#1A3A6B"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="10,5"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="FontFamily" Value="{StaticResource CairoFont}"/>
                                    <Setter Property="FontSize" Value="12"/>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="10,2"/>
                                    <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="التاريخ والوقت" Binding="{Binding ActionAt, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}" Width="1.2*" />
                                <DataGridTextColumn Header="العملية المنفذة" Binding="{Binding Action}" Width="1*" />
                                <DataGridTextColumn Header="الكيان المتأثر" Binding="{Binding EntityName}" Width="1*" />
                                <DataGridTextColumn Header="المنفذ" Binding="{Binding Username}" Width="1*" />
                                <DataGridTextColumn Header="تفاصيل العملية" Binding="{Binding Details}" Width="3.2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
